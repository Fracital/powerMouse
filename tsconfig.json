{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable",
			"WebWorker",
			"WebWorker.Iterable",
			"WebWorker.ImportScripts"
		],
		"types": ["serviceworker"],
		"strict": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"stripInternal": true,
		"sourceMap": true,
		"noEmit": true
	},
	"include": ["./src/**/*.ts"]
}
