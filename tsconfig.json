{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable",
			"WebWorker",
			"Webworker.Iterable",
			"WebWorker.ImportScripts"
		],
		"types": ["serviceworker"],
		"sourceMap": true,
		"strict": true,
		"stripInternal": true,
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true
	},
	"include": ["./src/**/*.ts"]
}
