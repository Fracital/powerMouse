+/// A Tor stream to `host:port` as a pair of web streams (TorClient::connect).
+async fn connect_impl(
+    client: &ArtiTorClient<WasmRuntime>,
+    host: &str,
+    port: u16,
+    isolation: Option<IsolationToken>,
+) -> Result<JsValue, JsValue> {
+    use futures::io::{AsyncReadExt, AsyncWriteExt};
+    // the destination stays out of the log, as fetch's path does
+    info!("Opening a stream via Tor");
+    let stream = match isolation {
+        Some(token) => {
+            let mut prefs = StreamPrefs::new();
+            prefs.set_isolation(token);
+            client.connect_with_prefs((host, port), &prefs).await
+        }
+        None => client.connect((host, port)).await,
+    }
+    .map_err(|e| JsTorError::connect_failed(&e).into_js_value())?;
+    let (reader, writer) = stream.split();
+    let chunks = futures::stream::unfold(Some(reader), |state| async move {
+        let mut reader = state?;
+        let mut buf = vec![0u8; 16 * 1024];
+        match reader.read(&mut buf).await {
+            Ok(0) => None,
+            Ok(n) => Some((Ok(js_sys::Uint8Array::from(&buf[..n]).into()), Some(reader))),
+            Err(e) => Some((
+                Err(JsTorError::internal(format!("Tor stream read failed: {}", e)).into_js_value()),
+                None,
+            )),
+        }
+    });
+    let readable: web_sys::ReadableStream = wasm_streams::ReadableStream::from_stream(chunks).into_raw();
+    let sink = futures::sink::unfold(writer, |mut writer, chunk: JsValue| async move {
+        let bytes = chunk
+            .dyn_into::<js_sys::Uint8Array>()
+            .map_err(|_| {
+                JsTorError::new("INVALID_OPTIONS", "validation", "a Tor stream takes Uint8Array chunks", false)
+                    .into_js_value()
+            })?
+            .to_vec();
+        writer
+            .write_all(&bytes)
+            .await
+            .map_err(|e| JsTorError::internal(format!("Tor stream write failed: {}", e)).into_js_value())?;
+        writer
+            .flush()
+            .await
+            .map_err(|e| JsTorError::internal(format!("Tor stream flush failed: {}", e)).into_js_value())?;
+        Ok::<_, JsValue>(writer)
+    });
+    let writable: web_sys::WritableStream = wasm_streams::WritableStream::from_sink(sink).into_raw();
+    let out = js_sys::Object::new();
+    js_sys::Reflect::set(&out, &JsValue::from_str("readable"), &readable)?;
+    js_sys::Reflect::set(&out, &JsValue::from_str("writable"), &writable)?;
+    Ok(out.into())
+}
