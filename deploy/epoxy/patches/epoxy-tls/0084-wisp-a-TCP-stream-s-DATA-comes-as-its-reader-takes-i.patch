+/// What a stream's reader has granted the server (stream credit, 0xE2).
+///
+/// A grant goes out once the reader has consumed half the window since the
+/// last one, for the bytes consumed plus the window: the server never has
+/// more than a window outstanding past what the reader took, as a native
+/// socket's receive window holds a remote back. The window grows as TCP's
+/// receive autotuning grows it: when the reader finds nothing to read and
+/// the server stopped exactly at a limit it was given (all it was allowed
+/// came, and the next grant had not come into effect yet), the window was
+/// what held the stream back, and it doubles, up to `MAX_WINDOW` and within
+/// what the connection's `WINDOW_BUDGET` has left. A reader that keeps up
+/// within a round trip grows it so each round trip; one that stalls is
+/// just not granted more.
+struct ReadCredit {
+	budget: Arc<CreditBudget>,
+	window: u64,
+	/// what the reader took (bytes of DATA payload)
+	consumed: u64,
+	/// the latest limit granted (the INFO's initial window before any)
+	granted: u64,
+	/// the limit before it: data that stops exactly here waited for `granted`
+	previous: u64,
+	/// what had been received when the window last grew: it grows once per stall
+	grown_at: u64,
+}
+
+impl ReadCredit {
+	fn new(budget: Arc<CreditBudget>) -> Self {
+		let initial = budget.initial;
+		Self {
+			budget,
+			window: initial,
+			consumed: 0,
+			granted: initial,
+			previous: initial,
+			grown_at: 0,
+		}
+	}
+
+	/// a new limit to grant, when the reader took `bytes` and half the window is used
+	fn took(&mut self, bytes: usize) -> Option<u64> {
+		self.consumed += bytes as u64;
+		if self.granted.saturating_sub(self.consumed) > self.window / 2 {
+			return None;
+		}
+		self.grant()
+	}
+
+	/// a new limit to grant, when the reader found nothing to read and the
+	/// server stopped at a limit (`received`: what came so far)
+	fn starved(&mut self, received: u64) -> Option<u64> {
+		if received <= self.grown_at || (received != self.previous && received != self.granted)
+		{
+			return None;
+		}
+		self.grown_at = received;
+		let want = self.window.min(MAX_WINDOW.saturating_sub(self.window));
+		let grew = self.budget.take(want);
+		if grew == 0 {
+			return None;
+		}
+		self.window += grew;
+		self.grant()
+	}
+
+	fn grant(&mut self) -> Option<u64> {
+		let limit = self.consumed + self.window;
+		if limit <= self.granted {
+			return None;
+		}
+		self.previous = self.granted;
+		self.granted = limit;
+		Some(limit)
+	}
+}
+
+impl Drop for ReadCredit {
+	fn drop(&mut self) {
+		self.budget.give(self.window - self.budget.initial);
+	}
+}
