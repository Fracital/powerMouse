+/// The connection's stream credit (extension 0xE2), when both sides named
+/// it: each stream's initial window and what all the windows have grown
+/// past it together, which `WINDOW_BUDGET` bounds.
+pub(crate) struct CreditBudget {
+	pub initial: u64,
+	grown: AtomicU64,
+}
+
+impl CreditBudget {
+	fn new(initial: u32) -> Self {
+		Self {
+			initial: u64::from(initial),
+			grown: AtomicU64::new(0),
+		}
+	}
+
+	/// takes up to `want` bytes of growth from the budget, and says how much it took
+	pub fn take(&self, want: u64) -> u64 {
+		let grown = self.grown.load(Ordering::Relaxed);
+		let took = want.min(WINDOW_BUDGET.saturating_sub(grown));
+		self.grown.store(grown + took, Ordering::Relaxed);
+		took
+	}
+
+	/// gives back growth a stream had (its reader is gone)
+	pub fn give(&self, bytes: u64) {
+		let grown = self.grown.load(Ordering::Relaxed);
+		self.grown
+			.store(grown.saturating_sub(bytes), Ordering::Relaxed);
+	}
 }
 
