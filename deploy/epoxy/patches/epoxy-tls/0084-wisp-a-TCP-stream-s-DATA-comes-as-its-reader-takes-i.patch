index 0000000..17ba1ec
--- /dev/null
+++ b/wisp/src/extensions/credit.rs
@@ -0,0 +1,135 @@
+//! Stream credit (extension and packet 0xE2): per-stream flow control
+//! toward the client.
+//!
+//! Wisp's CONTINUE paces what the client sends; nothing paced what the
+//! server sends, so a server read a remote as fast as its transport drained
+//! whether or not the page read the body. With stream credit the server
+//! never sends a TCP stream's DATA past a limit the client grants as its
+//! reader consumes, as a native socket's receive window holds the remote
+//! back. Both INFOs must name it; the client names it only when the
+//! server's INFO did. A UDP stream is never counted.
+//!
+//! The client's INFO carries `initial_window` (u32 LE): the bytes of DATA
+//! the server may send on each stream before the first grant. A CREDIT
+//! packet (type 0xE2, the stream's id, then the new limit as u64 LE) is
+//! absolute: the total DATA payload the server may have sent on the stream
+//! from its start. The stream's reader grants (see `stream::MuxStreamRead`).
+use async_trait::async_trait;
+use bytes::{BufMut, Bytes, BytesMut};
+
+use crate::{Role, WispError};
+
+use super::{AnyProtocolExtension, ProtocolExtension, ProtocolExtensionBuilder};
+
+/// The window a stream starts with, before any grant (bytes).
+pub const INITIAL_WINDOW: u32 = 256 * 1024;
+/// The most one stream's window grows to (bytes): a gigabit at 138 ms.
+pub const MAX_WINDOW: u64 = 16 * 1024 * 1024;
+/// The most the windows of all the connection's streams may have grown past
+/// `INITIAL_WINDOW` together (bytes).
+pub const WINDOW_BUDGET: u64 = 64 * 1024 * 1024;
+/// The smallest initial window a server takes (smaller is taken as this).
+const MIN_WINDOW: u32 = 16 * 1024;
+
+#[derive(Debug, Clone, Copy)]
+/// Stream credit protocol extension.
+pub struct StreamCreditProtocolExtension {
+	/// The bytes of DATA each stream may receive before its first grant.
+	pub initial_window: u32,
+	role: Role,
+}
+
+impl StreamCreditProtocolExtension {
+	/// Stream credit protocol extension ID (and its packet's type).
+	pub const ID: u8 = 0xE2;
+}
+
+#[async_trait]
+impl ProtocolExtension for StreamCreditProtocolExtension {
+	fn get_id(&self) -> u8 {
+		Self::ID
+	}
+
+	fn encode(&self) -> Bytes {
+		match self.role {
+			// the server says nothing more (bytes after 0 are reserved)
+			Role::Server => Bytes::new(),
+			Role::Client => {
+				let mut bytes = BytesMut::with_capacity(4);
+				bytes.put_u32_le(self.initial_window);
+				bytes.freeze()
+			}
+		}
+	}
+
+	fn box_clone(&self) -> Box<dyn ProtocolExtension + Sync + Send> {
+		Box::new(*self)
+	}
+}
+
+/// Stream credit protocol extension builder.
+pub struct StreamCreditProtocolExtensionBuilder {
+	/// The initial window this side asks for (the client's).
+	pub initial_window: u32,
+}
+
+impl StreamCreditProtocolExtensionBuilder {
+	/// A builder that asks for `INITIAL_WINDOW`.
+	pub fn new() -> Self {
+		Self {
+			initial_window: INITIAL_WINDOW,
+		}
+	}
+}
+
+impl Default for StreamCreditProtocolExtensionBuilder {
+	fn default() -> Self {
+		Self::new()
+	}
+}
+
+impl ProtocolExtensionBuilder for StreamCreditProtocolExtensionBuilder {
+	fn get_id(&self) -> u8 {
+		StreamCreditProtocolExtension::ID
+	}
+
+	fn build_from_bytes(
+		&mut self,
+		bytes: Bytes,
+		role: Role,
+	) -> Result<AnyProtocolExtension, WispError> {
+		// the client reads the server's (empty) metadata and keeps its own
+		// window; a server reads the client's window
+		let initial_window = match role {
+			Role::Client => self.initial_window,
+			Role::Server => {
+				let Some(window) = bytes.get(..4) else {
+					return Err(WispError::PacketTooSmall);
+				};
+				u32::from_le_bytes([window[0], window[1], window[2], window[3]])
+			}
+		};
+		Ok(StreamCreditProtocolExtension {
+			initial_window: initial_window.max(MIN_WINDOW),
+			role,
+		}
+		.into())
+	}
+
+	fn build_to_extension(&mut self, role: Role) -> Result<AnyProtocolExtension, WispError> {
+		Ok(StreamCreditProtocolExtension {
+			initial_window: self.initial_window.max(MIN_WINDOW),
+			role,
+		}
+		.into())
+	}
+}
+
+/// A CREDIT packet: `stream_id` may have been sent `limit` bytes of DATA.
+pub(crate) fn credit_packet(stream_id: u32, limit: u64) -> Bytes {
+	let mut bytes = BytesMut::with_capacity(13);
+	bytes.put_u8(StreamCreditProtocolExtension::ID);
+	bytes.put_u32_le(stream_id);
+	bytes.put_u64_le(limit);
+	bytes.freeze()
+}
