-full = ["dep:fastwebsockets", "dep:async-compression", "dep:rustls-webpki", "dep:rustls-pemfile", "hyper-util-wasm/http2"]
+full = ["dep:fastwebsockets", "dep:async-compression", "dep:rustls-webpki", "dep:rustls-pemfile", "hyper-util-wasm/http2", "dep:ml-kem", "dep:rand_core", "dep:rustls"]
 
diff --git a/client/src/stream_provider.rs b/client/src/stream_provider.rs
