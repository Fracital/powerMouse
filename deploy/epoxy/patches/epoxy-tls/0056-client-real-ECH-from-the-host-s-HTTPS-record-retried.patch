+/// `config` offering ECH with `ech` (one config per connection: the list
+/// comes from the server's DNS record)
+#[cfg(feature = "full")]
+fn with_ech(config: &Arc<ClientConfig>, ech: EchConfig) -> Arc<ClientConfig> {
+	let mut config = ClientConfig::clone(config);
+	config.set_ech_mode(Some(EchMode::Enable(ech)));
+	Arc::new(config)
+}
