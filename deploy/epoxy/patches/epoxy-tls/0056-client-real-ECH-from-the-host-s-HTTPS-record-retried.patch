+	/// The host's ECH config list from `ech_resolver`, when it gives one
+	/// this build can use
+	#[cfg(feature = "full")]
+	fn ech_config(&self, host: &str) -> impl Future<Output = Option<EchConfig>> + use<> {
+		use futures_rustls::rustls::{
+			crypto::ring::hpke::ALL_SUPPORTED_SUITES, pki_types::EchConfigListBytes,
+		};
+		// an address has no HTTPS record (and gets no SNI either)
+		let call = match (&self.ech_resolver, ServerName::try_from(bare_host(host))) {
