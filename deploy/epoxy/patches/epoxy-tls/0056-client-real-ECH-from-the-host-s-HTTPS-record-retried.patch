+		// runs while the wisp stream opens
+		#[cfg(feature = "full")]
+		{
+			let ech = match alpn {
+				TlsAlpn::None => None,
+				_ => Some(self.ech_config(&host)),
+			};
+			let (stream, ech) = futures_util::future::join(
+				self.get_asyncread(StreamType::Tcp, host.clone(), port),
+				async move {
+					match ech {
+						Some(ech) => ech.await,
+						None => None,
+					}
+				},
+			)
 			.await;
+			let Some(ech) = ech else {
+				return self.handshake(stream?, &host, config.clone()).await;
