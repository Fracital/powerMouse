+
+	/// asked for a host's ECH config list (the `ech` of its HTTPS DNS
+	/// record) before a TLS connection to it opens
+	ech_resolver: Option<SendWrapper<Function>>,
+}
+
+/// What a TLS handshake that offered ECH ended with when the server
+/// rejected the offer (RFC 9849 6.1.6)
+#[cfg(feature = "full")]
+enum EchRejection {
+	/// it sent configs to retry with
+	Retry(EchConfig),
+	/// it sent none (ECH is off there) or answered with TLS 1.2
+	Disabled,
+}
+
+#[cfg(feature = "full")]
+fn ech_rejection(err: &std::io::Error) -> Option<EchRejection> {
+	use futures_rustls::rustls::{
+		crypto::ring::hpke::ALL_SUPPORTED_SUITES, Error, PeerIncompatible,
+	};
+	match err.get_ref()?.downcast_ref::<Error>()? {
+		Error::PeerIncompatible(PeerIncompatible::ServerRejectedEncryptedClientHello(
+			configs,
+		)) => Some(
+			configs
+				.as_deref()
+				.and_then(|configs| {
+					EchConfig::from_retry_configs(configs, ALL_SUPPORTED_SUITES).ok()
+				})
+				.map_or(EchRejection::Disabled, EchRejection::Retry),
+		),
+		_ => None,
+	}
 }
 
 /// What a TLS connection offers in ALPN.
