+				resolver.call1(&JsValue::NULL, &JsValue::from_str(host)).ok()
+			}
+			_ => None,
+		};
+		let call = call.map(|x| SendWrapper::new(JsFuture::from(Promise::resolve(&x))));
+		async move {
