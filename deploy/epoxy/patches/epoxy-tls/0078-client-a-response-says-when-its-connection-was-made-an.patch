+
+/// When a connection's steps happened, in this realm's `performance.now()`,
+/// as a browser's resource timing tells them: a lookup the connection waited
+/// on (the HTTPS record, for ECH: the addresses are the wisp server's to
+/// look up), the wisp stream asked for, the ClientHello written and the
+/// handshake done. Every response over the connection carries it in its
+/// extensions (`Connected::extra`); one over a kept connection also has
+/// hyper-util's `ReusedConnection`.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct ConnectTiming {
+	pub dns_start: Option<f64>,
+	pub dns_end: Option<f64>,
+	pub connect_start: f64,
+	pub secure_start: Option<f64>,
+	pub connect_end: f64,
+}
