+/// When the request that a response answers was handed to the client
+/// (`performance.now()`), in the response's extensions
+#[derive(Clone, Copy)]
+struct RequestAt(f64);
+
+/// A response's connection as a browser's resource timing tells it, in this
+/// realm's `performance.now()`: `{ reused: true, requestStart }` over a kept
+/// connection (an HTTP/2 one still being made when the request came counts
+/// as kept, its `requestStart` when it was up); over a fresh one `connectStart`, `secureStart` (TLS),
+/// `connectEnd`, `requestStart` and, when the connection waited on a lookup
+/// of ours (the HTTPS record, for ECH), `dnsStart` and `dnsEnd`. The wisp
+/// server looks up the addresses and connects TCP: those are inside the
+/// time from `connectStart` to the server's first answer to the
+/// ClientHello.
+fn connection_timing(response: &Response<Incoming>) -> Object {
+	let out = Object::new();
+	let set = |key: &str, at: f64| object_set(&out, key, at.into());
+	let reused = response.extensions().get::<ReusedConnection>().is_some();
+	object_set(&out, "reused", reused.into());
+	let asked = response.extensions().get::<RequestAt>().map(|at| at.0);
+	let timing = response.extensions().get::<stream_provider::ConnectTiming>();
+	match timing {
+		Some(timing) if !reused => {
+			if let (Some(start), Some(end)) = (timing.dns_start, timing.dns_end) {
+				set("dnsStart", start);
+				set("dnsEnd", end);
+			}
+			set("connectStart", timing.connect_start);
+			if let Some(at) = timing.secure_start {
+				set("secureStart", at);
+			}
+			set("connectEnd", timing.connect_end);
+			// the head goes out as soon as the connection is up
+			set("requestStart", asked.map_or(timing.connect_end, |at| at.max(timing.connect_end)));
+		}
+		// a kept connection takes the head at once; an HTTP/2 one another
+		// request was still making (the pool hands it out shared) takes it
+		// once it is up
+		_ => {
+			if let Some(at) = asked {
+				set("requestStart", timing.map_or(at, |timing| at.max(timing.connect_end)));
+			}
+		}
+	}
+	out
+}
