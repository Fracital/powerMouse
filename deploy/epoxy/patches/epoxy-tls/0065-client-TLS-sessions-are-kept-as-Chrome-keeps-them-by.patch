@@ -0,0 +1,190 @@
+//! The TLS session cache, as Chrome keeps it.
+//!
+//! rustls keys sessions by server name alone, so a connection to another port
+//! of a host offered that port's ticket or PSK. Chrome's
+//! SSLClientSessionCache is keyed by host and port, holds at most 1024 keys
+//! in all (the least recently used goes first) and at most two sessions per
+//! key. Each network partition has one of these, shared by its HTTP,
+//! WebSocket and raw TLS connections; a connection sees it through a
+//! [`PortSessions`] for its port.
+
+use std::{
+	collections::{HashMap, VecDeque},
+	sync::{Arc, Mutex, PoisonError},
+};
+
+use futures_rustls::rustls::{
+	client::{ClientSessionStore, Resumption, Tls12ClientSessionValue, Tls13ClientSessionValue},
+	pki_types::ServerName,
+	ClientConfig, NamedGroup,
+};
+
+/// Chrome's `SSLClientSessionCache` size
+const MAX_KEYS: usize = 1024;
+/// Chrome's sessions per key (TLS 1.3 tickets are used once each)
+const TLS13_TICKETS_PER_KEY: usize = 2;
+
+type Key = (u16, ServerName<'static>);
+
+#[derive(Default)]
+struct Entry {
+	kx_hint: Option<NamedGroup>,
+	tls12: Option<Tls12ClientSessionValue>,
+	tls13: VecDeque<Tls13ClientSessionValue>,
+	/// when the key was last used, on `Inner::clock`
+	used: u64,
+}
+
+#[derive(Default)]
+struct Inner {
+	entries: HashMap<Key, Entry>,
+	clock: u64,
+}
+
+impl Inner {
+	/// the entry for `key`, made (the least recently used one dropped for it
+	/// when the cache is full) if `make`
+	fn entry(&mut self, key: Key, make: bool) -> Option<&mut Entry> {
+		self.clock += 1;
+		let now = self.clock;
+		if make && !self.entries.contains_key(&key) && self.entries.len() >= MAX_KEYS {
+			let oldest = self
+				.entries
+				.iter()
+				.min_by_key(|(_, entry)| entry.used)
+				.map(|(key, _)| key.clone());
+			if let Some(oldest) = oldest {
+				self.entries.remove(&oldest);
+			}
+		}
+		let entry = match make {
+			true => self.entries.entry(key).or_default(),
+			false => self.entries.get_mut(&key)?,
+		};
+		entry.used = now;
+		Some(entry)
+	}
+}
+
+/// One network partition's sessions.
+#[derive(Default)]
+pub struct SessionCache(Mutex<Inner>);
+
+impl SessionCache {
+	/// `config` resuming from, and storing into, the sessions of `port`
+	pub fn config(self: &Arc<Self>, config: &Arc<ClientConfig>, port: u16) -> Arc<ClientConfig> {
+		let mut config = ClientConfig::clone(config);
+		// rustls's default otherwise: TLS 1.2 by session id or ticket
+		config.resumption = Resumption::store(Arc::new(PortSessions {
+			port,
+			cache: self.clone(),
+		}));
+		Arc::new(config)
+	}
+
+	fn with<T>(
+		&self,
+		port: u16,
+		name: &ServerName<'_>,
+		make: bool,
+		f: impl FnOnce(&mut Entry) -> T,
+	) -> Option<T> {
+		let mut inner = self.0.lock().unwrap_or_else(PoisonError::into_inner);
+		inner.entry((port, name.to_owned()), make).map(f)
+	}
+}
+
+/// The [`SessionCache`] as one port's connections see it.
+pub struct PortSessions {
+	port: u16,
+	cache: Arc<SessionCache>,
+}
+
+impl std::fmt::Debug for PortSessions {
+	fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+		f.debug_struct("PortSessions")
+			.field("port", &self.port)
+			.finish_non_exhaustive()
+	}
+}
+
+impl ClientSessionStore for PortSessions {
+	fn set_kx_hint(&self, server_name: ServerName<'static>, group: NamedGroup) {
+		self.cache.with(self.port, &server_name, true, |entry| {
+			entry.kx_hint = Some(group)
+		});
+	}
+
+	fn kx_hint(&self, server_name: &ServerName<'_>) -> Option<NamedGroup> {
+		self.cache
+			.with(self.port, server_name, false, |entry| entry.kx_hint)
+			.flatten()
+	}
+
+	fn set_tls12_session(&self, server_name: ServerName<'static>, value: Tls12ClientSessionValue) {
+		self.cache.with(self.port, &server_name, true, |entry| {
+			entry.tls12 = Some(value)
+		});
+	}
+
+	fn tls12_session(&self, server_name: &ServerName<'_>) -> Option<Tls12ClientSessionValue> {
+		self.cache
+			.with(self.port, server_name, false, |entry| entry.tls12.clone())
+			.flatten()
+	}
+
+	fn remove_tls12_session(&self, server_name: &ServerName<'static>) {
+		self.cache
+			.with(self.port, server_name, false, |entry| entry.tls12 = None);
+	}
+
+	fn insert_tls13_ticket(
+		&self,
+		server_name: ServerName<'static>,
+		value: Tls13ClientSessionValue,
+	) {
+		self.cache.with(self.port, &server_name, true, |entry| {
+			if entry.tls13.len() >= TLS13_TICKETS_PER_KEY {
+				entry.tls13.pop_front();
+			}
+			entry.tls13.push_back(value);
+		});
+	}
+
+	fn take_tls13_ticket(
+		&self,
+		server_name: &ServerName<'static>,
+	) -> Option<Tls13ClientSessionValue> {
+		self.cache
+			.with(self.port, server_name, false, |entry| {
+				entry.tls13.pop_back()
+			})
+			.flatten()
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn bounded_and_least_recently_used_first() {
+		let cache = Arc::new(SessionCache::default());
+		let name = ServerName::try_from("example.com").unwrap();
+		let hint = |port| PortSessions {
+			port,
+			cache: cache.clone(),
+		};
+		for port in 0..(MAX_KEYS as u16 + 100) {
+			hint(port).set_kx_hint(name.clone(), NamedGroup::X25519);
+			// port 0 stays in use
+			let _ = hint(0).kx_hint(&name);
+		}
+		assert_eq!(cache.0.lock().unwrap().entries.len(), MAX_KEYS);
+		assert!(hint(0).kx_hint(&name).is_some());
+		assert!(hint(1).kx_hint(&name).is_none());
+		assert!(hint(MAX_KEYS as u16 + 99).kx_hint(&name).is_some());
+		// another port of the same name is another key
+		assert!(hint(MAX_KEYS as u16 + 100).kx_hint(&name).is_none());
+	}
+}
