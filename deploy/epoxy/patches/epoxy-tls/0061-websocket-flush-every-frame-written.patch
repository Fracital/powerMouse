+/// Writes a frame and flushes it. fastwebsockets only writes a frame into
+/// the stream, and a wisp stream (with or without TLS over it) queues what
+/// it is written: the packet goes out on the sink's next poll, which is the
+/// socket's next frame or another stream's write on the same connection. A
+/// message the page sent, a close and the answer to a ping or to the
+/// server's close waited in epoxy until then, so a server answering the page
+/// seemed silent until the page wrote again.
+async fn write_flushed<S: AsyncWrite + Unpin>(
+	tx: &mut WebSocketWrite<S>,
+	frame: Frame<'_>,
+) -> Result<(), WebSocketError> {
+	tx.write_frame(frame).await?;
+	tx.flush().await
+}
+
 /// A close frame's status code and reason; a frame without a status
 /// reads 1005, as in a browser, and a reason that is not UTF-8 is empty
 /// (fastwebsockets has failed such a frame already)
