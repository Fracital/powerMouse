+++ b/client/src/lib.rs
@@ -402,6 +402,9 @@ fn create_wisp_transport(function: Function) -> ProviderWispTransportGenerator {
 pub struct EpoxyClient {
 	stream_provider: Arc<StreamProvider>,
 	client: Client<StreamProviderService, StreamingBody>,
+	/// what http_client was built with, for a partition's
+	title_case_headers: bool,
+	http_header_limit: usize,
 
 	certs_tampered: bool,
 
@@ -415,6 +418,48 @@ pub struct EpoxyClient {
 	pub buffer_size: usize,
 }
 
+/// The HTTP client (its connection pool) over `stream_provider`, with
+/// Chrome's settings
+fn http_client(
+	stream_provider: &Arc<StreamProvider>,
+	title_case_headers: bool,
+	header_limit: usize,
+) -> Client<StreamProviderService, StreamingBody> {
+	let service = StreamProviderService(stream_provider.clone());
+	let mut builder = Client::builder(WasmExecutor);
+	builder
+		.http09_responses(true)
+		.http1_title_case_headers(title_case_headers)
+		.http1_max_headers(header_limit)
+		// hyper refuses a whole HTTP/1 response over one header line it
+		// does not like, where Chrome reads the response: it skips a line
+		// with no colon or a control character, accepts a space before the
+		// colon and joins an obs-fold line to the one before it
+		.http1_ignore_invalid_headers_in_responses(true)
+		.http1_allow_spaces_after_header_name_in_responses(true)
+		.http1_allow_obsolete_multiline_headers_in_responses(true);
+
+	#[cfg(feature = "full")]
+	builder.http2_max_concurrent_reset_streams(10); // set back to default, on wasm it is 0
+	// hyper's HTTP/2 default caps a response header block at 16 KiB and resets the
+	// stream with PROTOCOL_ERROR past it; YouTube sends 12 to 20 KiB of headers
+	// (cookies, report-only policies). Chrome allows 256 KiB; match it.
+	#[cfg(feature = "full")]
+	builder.http2_max_header_list_size(256 * 1024);
+	// the rest of Chrome's SETTINGS and its first WINDOW_UPDATE (the
+	// Akamai HTTP/2 fingerprint 1:65536;2:0;4:6291456;6:262144|15663105):
+	// a 64 KiB HPACK table, 6 MiB stream windows, a 15 MiB connection
+	// window, and no MAX_FRAME_SIZE (hyper announced 16384, the default)
+	#[cfg(feature = "full")]
+	builder
+		.http2_header_table_size(65536)
+		.http2_initial_stream_window_size(6 * 1024 * 1024)
+		.http2_initial_connection_window_size(15 * 1024 * 1024)
+		.http2_adaptive_window(false)
+		.http2_max_frame_size(None);
+	builder.build(service)
+}
+
 #[wasm_bindgen]
 impl EpoxyClient {
 	#[wasm_bindgen(constructor)]
