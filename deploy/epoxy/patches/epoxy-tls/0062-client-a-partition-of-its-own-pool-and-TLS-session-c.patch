+	/// A provider over the same wisp connection (and the one that replaces
+	/// it) with TLS session caches of its own: a network partition's. A
+	/// browser keys its connections, and the TLS sessions it resumes, by the
+	/// top-level site; each connection is a wisp stream already, so a
+	/// partition needs no wisp connection of its own, only its own pool
+	/// (EpoxyClient::partition) and these caches.
+	pub fn partition(&self) -> Self {
+		let fresh = |config: &Arc<ClientConfig>| {
+			let mut config = ClientConfig::clone(config);
+			config.resumption = Resumption::default();
+			Arc::new(config)
+		};
+		Self {
+			wisp_generator: self.wisp_generator.clone(),
+			wisp_v2: self.wisp_v2,
+			udp_extension: self.udp_extension,
+			current_client: self.current_client.clone(),
+			h2_config: fresh(&self.h2_config),
+			ws_config: fresh(&self.ws_config),
+			client_config: fresh(&self.client_config),
+			ech_resolver: self.ech_resolver.clone(),
+		}
+	}
+
 	async fn create_client(
 		&self,
 		mut locked: MutexGuard<'_, Option<ClientMux<ProviderWispTransportWrite>>>,
@@ -232,7 +257,7 @@ impl StreamProvider {
 			None
 		};
 
-		let (read, write) = (self.wisp_generator)(self.wisp_v2).await?;
+		let (read, write) = (self.wisp_generator.as_ref())(self.wisp_v2).await?;
 
 		let client = ClientMux::new(read, write, extensions).await?;
 		let (mux, fut) = if self.udp_extension {
