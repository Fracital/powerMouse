@@ -518,6 +537,34 @@ impl EpoxyClient {
 		})
 	}
 
+	/// A client of its own connection pool and TLS session caches over this
+	/// client's wisp connection: a network partition's (a browser keeps
+	/// apart what pages of different top-level sites connect to, and every
+	/// connection is a wisp stream, so the partition opens no new wisp
+	/// connection)
+	pub fn partition(&self) -> EpoxyClient {
+		let stream_provider = Arc::new(self.stream_provider.partition());
+		let client = http_client(
+			&stream_provider,
+			self.title_case_headers,
+			self.http_header_limit,
+		);
+		Self {
+			stream_provider,
+			client,
+			certs_tampered: self.certs_tampered,
+			title_case_headers: self.title_case_headers,
+			http_header_limit: self.http_header_limit,
+			redirect_limit: self.redirect_limit,
+			#[cfg(feature = "full")]
+			header_limit: self.header_limit,
+			#[cfg(feature = "full")]
+			ws_title_case_headers: self.ws_title_case_headers,
+			user_agent: self.user_agent.clone(),
+			buffer_size: self.buffer_size,
+		}
+	}
+
 	pub async fn replace_stream_provider(&self) -> Result<(), EpoxyError> {
 		self.stream_provider.replace_client().await
 	}
