-	fn maybe_write(&mut self) -> Result<(), WispError> {
-		if let Some(chunk) = self.chunk.take() {
-			let packet = Packet::new_data(self.info.id, chunk).encode();
-			self.write.get().start_send(packet)?;
+	/// Sends the pending chunk as DATA packets of at most
+	/// `MAX_DATA_PAYLOAD` bytes, each after flow control allows one more.
+	/// The write lock is let go between packets so other streams' packets
+	/// can go out between them.
+	fn poll_write_chunk(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), WispError>> {
+		while let Some(chunk) = self.chunk.as_ref() {
+			let last = chunk.len() <= MAX_DATA_PAYLOAD;
+			ready!(poll_flow_credit(&self.info, &mut self.write, cx))?;
+			ready!(self.write.poll_lock(cx));
+			unlock!(self.write, ready!(self.write.get().poll_ready(cx)));
+
+			let part = if last {
+				self.chunk.take().expect("chunk was checked above")
+			} else {
+				self.chunk
+					.as_mut()
+					.expect("chunk was checked above")
+					.split_to(MAX_DATA_PAYLOAD)
+			};
+			let packet = Packet::new_data(self.info.id, part).encode();
+			unlock!(self.write, self.write.get().start_send(packet));
+			self.write.unlock();
 
 			if self.info.flow_status == FlowControl::EnabledTrackAmount {
 				self.info.flow_dec();
 			}
 		}
 
-		Ok(())
+		Poll::Ready(Ok(()))
 	}
 }
 
