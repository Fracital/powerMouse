+/// The largest payload this side puts in one DATA packet. A Wisp server
+/// bounds the WebSocket messages it accepts (holyWisp's `max-message-size`,
+/// 256 KiB plus the 5-byte header on the public relays) and closes the whole
+/// connection past it, every stream on it, with 1009. Nothing in the
+/// handshake says what the bound is (no extension carries it), so a write
+/// goes out as packets of at most this many bytes, far under any server's
+/// limit, each one counted against the stream's flow control window. It is
+/// also above the largest UDP datagram (65507 bytes over IPv4), so a
+/// datagram a native socket could send fits in one packet.
+pub const MAX_DATA_PAYLOAD: usize = 64 * 1024;
+
+/// Waits for flow control credit when the stream counts what it sends.
+/// The waker is registered before the second look, so a CONTINUE that
+/// lands in between is not missed. While it waits, the transport is
+/// flushed: a packet handed to it with `start_send` may only go out on the
+/// next poll, and the server sends no CONTINUE before it has counted the
+/// window's last packet, so an unflushed one stalled the stream for good.
+fn poll_flow_credit<W: TransportWrite>(
+	info: &StreamInfo,
+	write: &mut LockedWebSocketWrite<W>,
+	cx: &mut Context<'_>,
+) -> Poll<Result<(), WispError>> {
+	if info.flow_status != FlowControl::EnabledTrackAmount || !info.flow_empty() {
+		return Poll::Ready(Ok(()));
+	}
+	info.flow_register(cx);
+	if !info.flow_empty() {
+		return Poll::Ready(Ok(()));
+	}
+	ready!(write.poll_lock(cx));
+	let flushed = write.get().poll_flush(cx);
+	write.unlock();
+	if let Poll::Ready(Err(err)) = flushed {
+		return Poll::Ready(Err(err));
+	}
+	Poll::Pending
+}
+
 macro_rules! unlock_some {
 	($unlock:expr, $x:expr) => {
 		if let Err(err) = $x {
@@ -197,17 +235,35 @@ impl<W: TransportWrite> MuxStreamWrite<W> {
