+type SharedDatagramWrite = Rc<RefCell<MuxStreamWrite<ProviderWispTransportWrite>>>;
+
+/// A UDP stream's write side, shared by its WritableStream and `send`. The
+/// stream is never borrowed across a poll, and both run on the one thread.
+struct DatagramSink(SharedDatagramWrite);
+
+impl Sink<Bytes> for DatagramSink {
+	type Error = EpoxyError;
+
+	fn poll_ready(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+		self.0.borrow_mut().poll_ready_unpin(cx).map_err(EpoxyError::Wisp)
+	}
+
+	fn start_send(self: Pin<&mut Self>, item: Bytes) -> Result<(), Self::Error> {
+		self.0.borrow_mut().start_send_unpin(item).map_err(EpoxyError::Wisp)
+	}
+
+	fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+		self.0.borrow_mut().poll_flush_unpin(cx).map_err(EpoxyError::Wisp)
+	}
+
+	fn poll_close(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+		self.0.borrow_mut().poll_close_unpin(cx).map_err(EpoxyError::Wisp)
+	}
+}
+
+async fn send_datagram(write: SharedDatagramWrite, datagram: JsValue) -> Result<JsValue, JsValue> {
+	let bytes = convert_body(datagram)
+		.await
+		.map_err(|_| EpoxyError::InvalidPayload)?;
+	let bytes = Bytes::from(bytes.0.to_vec());
+	poll_fn(|cx| write.borrow_mut().poll_ready_unpin(cx))
+		.await
+		.map_err(EpoxyError::Wisp)?;
+	write
+		.borrow_mut()
+		.start_send_unpin(bytes)
+		.map_err(EpoxyError::Wisp)?;
+	poll_fn(|cx| write.borrow_mut().poll_flush_unpin(cx))
+		.await
+		.map_err(EpoxyError::Wisp)?;
+	Ok(JsValue::UNDEFINED)
+}
+
+// A UDP stream gets `send(datagram)` next to its streams: like sendto(2) on a
+// native socket, a datagram over the size one Wisp packet carries fails that
+// call alone (EMSGSIZE) and the socket keeps working. A WritableStream cannot
+// do that, since a rejected write errors the whole stream; its write rejects
+// with the same error.
 pub fn iostream_from_stream(stream: ProviderUnencryptedStream) -> EpoxyIoStream {
 	let (rx, tx) = stream.into_split();
-	create_iostream(
+	let tx: SharedDatagramWrite = Rc::new(RefCell::new(tx));
+	let out = create_iostream_object(
 		Box::pin(rx.map_ok(Bytes::from).map_err(EpoxyError::Wisp)),
-		Box::pin(tx.sink_map_err(EpoxyError::Wisp)),
-	)
+		Box::pin(DatagramSink(tx.clone())),
+	);
+	let send = Closure::<dyn Fn(JsValue) -> Promise>::new(move |datagram: JsValue| {
+		future_to_promise(send_datagram(tx.clone(), datagram))
+	});
+	object_set(&out, "send", send.into_js_value());
+	JsValue::from(out).into()
 }
