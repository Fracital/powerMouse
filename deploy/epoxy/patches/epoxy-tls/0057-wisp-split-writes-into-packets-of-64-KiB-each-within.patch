 impl<W: TransportWrite> AsyncWrite for MuxStreamAsyncWrite<W> {
+	// One DATA packet per call, of at most MAX_DATA_PAYLOAD bytes, and only
+	// with flow control credit: the caller (hyper, rustls, write_all) writes
+	// the rest in further calls. A whole request body went out as one packet
+	// before, and a server that bounds its messages (the holyWisp relays take
+	// 256 KiB) closed the connection, every stream on it, with 1009; and the
+	// packets went out whatever CONTINUE had allowed.
 	fn poll_write(
 		mut self: Pin<&mut Self>,
 		cx: &mut Context<'_>,
 		buf: &[u8],
 	) -> Poll<io::Result<usize>> {
+		if buf.is_empty() {
+			return Poll::Ready(Ok(0));
+		}
+		let this = &mut *self;
+		ready!(poll_flow_credit(&this.info, &mut this.write, cx)).map_err(io::Error::other)?;
 		ready!(self.write.poll_lock(cx));
-		ready!(self.write.get().poll_ready(cx)).map_err(io::Error::other)?;
-
-		let packet = Packet::new_data(self.info.id, buf);
-		self.write
-			.get()
-			.start_send(packet.encode())
-			.map_err(io::Error::other)?;
+		if let Err(err) = ready!(self.write.get().poll_ready(cx)) {
+			self.write.unlock();
+			return Poll::Ready(Err(io::Error::other(err)));
+		}
 
+		let len = buf.len().min(MAX_DATA_PAYLOAD);
+		let packet = Packet::new_data(self.info.id, &buf[..len]);
+		if let Err(err) = self.write.get().start_send(packet.encode()) {
+			self.write.unlock();
+			return Poll::Ready(Err(io::Error::other(err)));
+		}
 		self.write.unlock();
-		Poll::Ready(Ok(buf.len()))
+
+		if self.info.flow_status == FlowControl::EnabledTrackAmount {
+			self.info.flow_dec();
+		}
+		Poll::Ready(Ok(len))
 	}
 
 	fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
