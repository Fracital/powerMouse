+
+/// The modulus and exponent of an RSAPublicKey (RFC 8017 appendix A.1.1),
+/// a subjectPublicKey's contents.
+pub fn rsa_public_key(key: &[u8]) -> Option<(&[u8], &[u8])> {
+	let mut outer = Reader(key);
+	let mut key = Reader(outer.read(SEQUENCE)?);
+	if !outer.is_empty() {
+		return None;
+	}
+	let n = positive(key.read(INTEGER)?)?;
+	let e = positive(key.read(INTEGER)?)?;
+	if !key.is_empty() {
+		return None;
+	}
+	Some((n, e))
+}
+
+/// The exact bit length of a big-endian magnitude.
+pub fn bits(magnitude: &[u8]) -> usize {
+	match magnitude.iter().position(|&b| b != 0) {
+		Some(i) => (magnitude.len() - i) * 8 - magnitude[i].leading_zeros() as usize,
+		None => 0,
 	}
 }
 
