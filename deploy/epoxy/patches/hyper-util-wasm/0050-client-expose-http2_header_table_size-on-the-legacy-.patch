From 71706d220a7a6d600c70b84644f9ec82714f1202 Mon Sep 17 00:00:00 2001
From: David Reed <reedswork@proton.me>
Date: Mon, 9 Nov 2026 23:05:31 -0500
Subject: [PATCH 50/51] client: expose http2_header_table_size on the legacy
 Builder

Forwards to hyper::client::conn::http2::Builder::header_table_size so a
client can announce SETTINGS_HEADER_TABLE_SIZE (Chrome sends 65536).
---
 src/client/legacy/client.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/client/legacy/client.rs b/src/client/legacy/client.rs
index 9873143..e33b76b 100644
--- a/src/client/legacy/client.rs
+++ b/src/client/legacy/client.rs
@@ -1416,6 +1416,18 @@ impl Builder {
         self
     }
 
+    /// Sets the HPACK dynamic table size the client announces in its
+    /// SETTINGS (`SETTINGS_HEADER_TABLE_SIZE`); Chrome sends 65536.
+    ///
+    /// See the documentation of [`h2::client::Builder::header_table_size`] for more
+    /// details.
+    #[cfg(feature = "http2")]
+    #[cfg_attr(docsrs, doc(cfg(feature = "http2")))]
+    pub fn http2_header_table_size(&mut self, size: impl Into<Option<u32>>) -> &mut Self {
+        self.h2_builder.header_table_size(size);
+        self
+    }
+
     /// Provide a timer to be used for h2
     ///
     /// See the documentation of [`h2::client::Builder::timer`] for more
