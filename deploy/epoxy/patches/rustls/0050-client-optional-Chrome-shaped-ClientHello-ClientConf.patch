diff --git a/src/client/chrome.rs b/src/client/chrome.rs
new file mode 100644
index 0000000..0b9efe8
--- /dev/null
+++ b/src/client/chrome.rs
@@ -0,0 +1,163 @@
+//! A ClientHello shaped like Chrome's (measured against Chrome 152, November
+//! 2026, with tls.peet.ws and tls.browserleaks.com).
+//!
+//! A TLS client that runs inside Chrome on behalf of a page (a proxy that
+//! tunnels the page's requests) should not present a ClientHello no browser
+//! sends. With [`ClientConfig::chrome_hello`] set, the hello carries Chrome's
+//! cipher suite list, GREASE (RFC 8701) in the cipher suites, extensions,
+//! supported groups, key shares, versions and signature algorithms, and the
+//! extensions BoringSSL adds for Chrome: signed certificate timestamps,
+//! renegotiation_info, ALPS (answered with the client's EncryptedExtensions
+//! after the server's Finished), a GREASE ECH and trust anchor ids. Extension
+//! order is random per connection with GREASE first and last, as Chrome's.
+//!
+//! Suites and signature schemes this crate cannot use are only offered: a
+//! server that picks one fails the handshake, as it failed before when they
+//! were absent from the hello.
+//!
+//! [`ClientConfig::chrome_hello`]: crate::client::ClientConfig::chrome_hello
+
+use alloc::vec;
+use alloc::vec::Vec;
+
+use crate::crypto::SecureRandom;
+use crate::error::Error;
+use crate::rand::GetRandomFailed;
+
+/// application_settings (ALPS), the codepoint Chrome has used since 2025
+pub(crate) const ALPS: u16 = 0x44cd;
+const SIGNED_CERTIFICATE_TIMESTAMP: u16 = 0x0012;
+const RENEGOTIATION_INFO: u16 = 0xff01;
+const ENCRYPTED_CLIENT_HELLO: u16 = 0xfe0d;
+/// trust_anchors (draft-ietf-tls-trust-anchor-ids), experimental codepoint
+const TRUST_ANCHORS: u16 = 0xca34;
+
+/// Chrome's cipher suites in its order, after its GREASE suite
+pub(crate) const CIPHER_SUITES: &[u16] = &[
+    0x1301, 0x1302, 0x1303, 0xc02b, 0xc02f, 0xc02c, 0xc030, 0xcca9, 0xcca8, 0xc013, 0xc014,
+    0x009c, 0x009d, 0x002f, 0x0035,
+];
+
+/// Chrome's signature algorithms in its order, after its GREASE value
+/// (ML-DSA-44/65/87 first)
+pub(crate) const SIGNATURE_ALGORITHMS: &[u16] = &[
+    0x0904, 0x0905, 0x0906, 0x0403, 0x0804, 0x0401, 0x0503, 0x0805, 0x0501, 0x0806, 0x0601,
+];
+
+/// Chrome's QUIC hello is QUICHE's: TLS 1.3 suites only, no GREASE, these
+/// signature algorithms (no ML-DSA, rsa_pkcs1_sha1 last)
+pub(crate) const QUIC_CIPHER_SUITES: &[u16] = &[0x1301, 0x1302, 0x1303];
+pub(crate) const QUIC_SIGNATURE_ALGORITHMS: &[u16] = &[
+    0x0403, 0x0804, 0x0401, 0x0503, 0x0805, 0x0501, 0x0806, 0x0601, 0x0201,
+];
+
+/// The body of the trust_anchors extension: an empty list. Chrome 152 sends
+/// the ids of the Chrome Root Store anchors (204 bytes), and a server that
+/// supports the draft then picks a chain for one of those anchors; Google's
+/// QUIC servers did, with a chain webpki-roots (Mozilla's store) could not
+/// verify (UnknownIssuer). Sent empty, the extension is there (JA4 counts
+/// it) and the server sends its default chain.
+const TRUST_ANCHOR_IDS: &[u8] = &[0x00, 0x00];
+
+/// The client's EncryptedExtensions message body Chrome sends once a server
+/// negotiated ALPS for h2: one application_settings extension, empty
+pub(crate) const CLIENT_ALPS_ENCRYPTED_EXTENSIONS: &[u8] = &[0x00, 0x04, 0x44, 0xcd, 0x00, 0x00];
+
+/// Which GREASE value goes where (BoringSSL's `ssl_grease_index_t`)
+#[derive(Clone, Copy)]
+pub(crate) enum Grease {
+    Cipher = 0,
+    Group = 1,
+    Extension1 = 2,
+    Extension2 = 3,
+    Version = 4,
+    SignatureAlgorithm = 5,
+}
+
+/// One connection's Chrome-only parts of the hello. Made once per
+/// connection and kept for a HelloRetryRequest's second hello, which keeps
+/// the GREASE values and the extra extensions as Chrome's does.
+#[derive(Clone, Debug)]
+pub(crate) struct ChromeHello {
+    seed: [u8; 6],
+    /// extensions rustls has no type for, by codepoint, with their bodies
+    pub(crate) extra: Vec<(u16, Vec<u8>)>,
+    /// this is the second hello, after a HelloRetryRequest
+    pub(crate) retry: bool,
+    /// the hello Chrome sends over QUIC: no GREASE, no TCP-only extensions
+    pub(crate) quic: bool,
+}
+
+impl ChromeHello {
+    pub(crate) fn new(
+        secure_random: &dyn SecureRandom,
+        alpn: &[&[u8]],
+        quic: bool,
+    ) -> Result<Self, Error> {
+        let mut seed = [0u8; 6];
+        secure_random.fill(&mut seed)?;
+
+        let mut extra = Vec::new();
+        if !quic {
+            extra.push((SIGNED_CERTIFICATE_TIMESTAMP, Vec::new()));
+            extra.push((RENEGOTIATION_INFO, vec![0x00]));
+        }
+        extra.push((TRUST_ANCHORS, TRUST_ANCHOR_IDS.to_vec()));
+        extra.push((ENCRYPTED_CLIENT_HELLO, grease_ech(secure_random)?));
+        // ALPS goes with the protocol it carries settings for: Chrome lists
+        // h2 over TCP and h3 over QUIC, and only in a hello that offers it
+        // (not a WebSocket's)
+        let alps = if quic { &b"h3"[..] } else { &b"h2"[..] };
+        if alpn.contains(&alps) {
+            let mut body = vec![0x00, 0x03, 0x02];
+            body.extend_from_slice(alps);
+            extra.push((ALPS, body));
+        }
+
+        Ok(Self {
+            seed,
+            extra,
+            retry: false,
+            quic,
+        })
+    }
+
+    /// BoringSSL's `ssl_get_grease_value`: 0x?a?a from one random byte per
+    /// slot, the two extension values never equal
+    pub(crate) fn grease(&self, which: Grease) -> u16 {
+        let value = |index: usize| {
+            let byte = (self.seed[index] & 0xf0) | 0x0a;
+            u16::from_be_bytes([byte, byte])
+        };
+        let mut ret = value(which as usize);
+        if matches!(which, Grease::Extension2) && ret == value(Grease::Extension1 as usize) {
+            ret ^= 0x1010;
+        }
+        ret
+    }
+
+    pub(crate) fn extra_types(&self) -> impl Iterator<Item = u16> + '_ {
+        self.extra.iter().map(|(typ, _)| *typ)
+    }
+}
+
+/// A GREASE encrypted_client_hello as BoringSSL builds it: an outer hello
+/// for HKDF-SHA256/AES-128-GCM, a random config id, a 32-byte random
+/// encapsulated key and a random payload of 128 to 224 bytes (in steps of
+/// 32) plus the AEAD tag
+fn grease_ech(secure_random: &dyn SecureRandom) -> Result<Vec<u8>, GetRandomFailed> {
+    let mut pick = [0u8; 2];
+    secure_random.fill(&mut pick)?;
+    let payload_len = 32 * (4 + usize::from(pick[1] % 4)) + 16;
+
+    let mut out = Vec::with_capacity(10 + 32 + payload_len);
+    out.extend_from_slice(&[0x00, 0x00, 0x01, 0x00, 0x01, pick[0], 0x00, 0x20]);
+    let mut enc = [0u8; 32];
+    secure_random.fill(&mut enc)?;
+    out.extend_from_slice(&enc);
+    out.extend_from_slice(&(payload_len as u16).to_be_bytes());
+    let mut payload = vec![0u8; payload_len];
+    secure_random.fill(&mut payload)?;
+    out.extend_from_slice(&payload);
+    Ok(out)
+}
