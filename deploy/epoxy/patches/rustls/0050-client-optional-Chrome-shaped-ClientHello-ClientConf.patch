+impl ClientExtensions<'_> {
+    /// Chrome's layout: an empty GREASE extension, every other extension
+    /// (rustls's and Chrome's extra ones) in random order, a one-byte GREASE
+    /// extension, then the PSK offer, which must be last. Groups, key shares,
+    /// versions and signature algorithms carry a GREASE value first; the
+    /// signature algorithms are Chrome's list.
+    fn encode_chrome(&self, chrome: &crate::client::chrome::ChromeHello, bytes: &mut Vec<u8>) {
+        use crate::client::chrome::{Grease, QUIC_SIGNATURE_ALGORITHMS, SIGNATURE_ALGORITHMS};
+
+        // over QUIC Chrome sends no GREASE and none of these
+        let tcp_only = [
+            ExtensionType::StatusRequest,
+            ExtensionType::ECPointFormats,
+            ExtensionType::ExtendedMasterSecret,
+            ExtensionType::SessionTicket,
+        ];
+        let mut order: Vec<u16> = self
+            .collect_used()
+            .into_iter()
+            .filter(|ext| *ext != ExtensionType::PreSharedKey)
+            .filter(|ext| !(chrome.quic && tcp_only.contains(ext)))
+            .map(u16::from)
+            .collect();
+        order.extend(chrome.extra_types());
+        order.sort_by_cached_key(|ext| {
+            low_quality_integer_hash(((self.order_seed as u32) << 16) | (*ext as u32))
+        });
+
+        let body = LengthPrefixedBuffer::new(ListLength::U16, bytes);
+        let out = &mut *body.buf;
+        let grease = |out: &mut Vec<u8>, which: Grease| {
+            if !chrome.quic {
+                chrome.grease(which).encode(out);
+            }
+        };
+
+        if !chrome.quic {
+            grease(out, Grease::Extension1);
+            0u16.encode(out);
+        }
+
+        for typ in order {
+            if let Some((_, data)) = chrome
+                .extra
+                .iter()
+                .find(|(extra, _)| *extra == typ)
+            {
+                typ.encode(out);
+                (data.len() as u16).encode(out);
+                out.extend_from_slice(data);
+                continue;
+            }
+            let ext = ExtensionType::from(typ);
+            match ext {
+                ExtensionType::EllipticCurves => {
+                    ext.encode(out);
+                    let body = LengthPrefixedBuffer::new(ListLength::U16, out);
+                    let list = LengthPrefixedBuffer::new(ListLength::U16, body.buf);
+                    grease(list.buf, Grease::Group);
+                    for group in self.named_groups.iter().flatten() {
+                        group.encode(list.buf);
+                    }
+                }
+                ExtensionType::KeyShare => {
+                    ext.encode(out);
+                    let body = LengthPrefixedBuffer::new(ListLength::U16, out);
+                    let list = LengthPrefixedBuffer::new(ListLength::U16, body.buf);
+                    // the second hello answers the group the server asked
+                    // for, with no GREASE share
+                    if !chrome.retry && !chrome.quic {
+                        grease(list.buf, Grease::Group);
+                        list.buf.extend_from_slice(&[0x00, 0x01, 0x00]);
+                    }
+                    for share in self.key_shares.iter().flatten() {
+                        share.encode(list.buf);
+                    }
+                }
+                ExtensionType::SupportedVersions => {
+                    ext.encode(out);
+                    let mut list = Vec::new();
+                    grease(&mut list, Grease::Version);
+                    if let Some(versions) = &self.supported_versions {
+                        if versions.tls13 {
+                            ProtocolVersion::TLSv1_3.encode(&mut list);
+                        }
+                        if versions.tls12 {
+                            ProtocolVersion::TLSv1_2.encode(&mut list);
+                        }
+                    }
+                    ((list.len() + 1) as u16).encode(out);
+                    out.push(list.len() as u8);
+                    out.extend_from_slice(&list);
+                }
+                ExtensionType::SignatureAlgorithms => {
+                    ext.encode(out);
+                    let body = LengthPrefixedBuffer::new(ListLength::U16, out);
+                    let list = LengthPrefixedBuffer::new(ListLength::U16, body.buf);
+                    grease(list.buf, Grease::SignatureAlgorithm);
+                    let schemes = match chrome.quic {
+                        true => QUIC_SIGNATURE_ALGORITHMS,
+                        false => SIGNATURE_ALGORITHMS,
+                    };
+                    for scheme in schemes {
+                        scheme.encode(list.buf);
+                    }
+                }
+                _ => self.encode_one(ext, out),
+            }
+        }
+
+        if !chrome.quic {
+            grease(out, Grease::Extension2);
+            1u16.encode(out);
+            out.push(0x00);
+        }
+
+        self.encode_one(ExtensionType::PreSharedKey, out);
+    }
+}
+
 impl<'a> Codec<'a> for ClientExtensions<'a> {
     fn encode(&self, bytes: &mut Vec<u8>) {
+        if let Some(chrome) = &self.chrome {
+            return self.encode_chrome(chrome, bytes);
+        }
+
         let order = self.used_extensions_in_encoding_order();
 
         if order.is_empty() {
@@ -1703,8 +1833,13 @@ impl<'a> Codec<'a> for CertificateExtensions<'a> {
         let mut sub = r.sub(len)?;
 
         while sub.any_left() {
-            out.read_one(&mut sub, |_unk| {
-                Err(InvalidMessage::UnknownCertificateExtension)
+            // a Chrome-shaped hello asks for signed certificate timestamps
+            // and offers trust anchor ids, which a server answers in its
+            // certificate entries; skip what this crate does not use, as
+            // Chrome reads past it
+            out.read_one(&mut sub, |unk| match u16::from(unk) {
+                0x0012 | 0xca34 => Ok(()),
+                _ => Err(InvalidMessage::UnknownCertificateExtension),
             })?;
         }
 
