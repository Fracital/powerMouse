+/// Encrypts a TLS 1.2 pre-master secret to the RSA key in a server's
+/// certificate, for the cipher suites whose key exchange is
+/// [`KeyExchangeAlgorithm::RSA`](crate::crypto::KeyExchangeAlgorithm::RSA)
+/// (RFC 5246 section 7.4.7.1).
+///
+/// It is asked only after the server's certificate chain was verified by the
+/// config's verifier, exactly as for an ECDHE suite. An implementation checks
+/// that the key may be used for key encipherment and that it is an RSA key
+/// of a size it accepts, and returns an error otherwise.
+pub trait RsaKeyTransport: fmt::Debug + Send + Sync {
+    /// Returns `pre_master_secret` encrypted with RSAES-PKCS1-v1_5 to the
+    /// public key of `end_entity` (the ClientKeyExchange's
+    /// `EncryptedPreMasterSecret` without its length prefix).
+    fn encrypt_pre_master_secret(
+        &self,
+        end_entity: &pki_types::CertificateDer<'_>,
+        pre_master_secret: &[u8],
+    ) -> Result<Vec<u8>, Error>;
+}
+
 /// A trait for the ability to choose a certificate chain and
 /// private key for the purposes of client authentication.
 pub trait ResolvesClientCert: fmt::Debug + Send + Sync {
@@ -293,6 +313,12 @@ pub struct ClientConfig {
     /// as are its certificate decompressors (Chrome's is brotli). Not used
     /// for QUIC. The default is `false`.
     pub chrome_hello: bool,
+
+    /// How to encrypt a pre-master secret to a server's RSA key, for a TLS 1.2
+    /// cipher suite with RSA key transport. A server that picks such a suite
+    /// when this is `None` fails the handshake. The default is `None`.
+    #[cfg(feature = "tls12")]
+    pub rsa_key_transport: Option<Arc<dyn RsaKeyTransport>>,
 }
 
