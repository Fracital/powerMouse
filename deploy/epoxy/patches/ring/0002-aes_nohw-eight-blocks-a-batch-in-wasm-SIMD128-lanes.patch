-      aes_word_t v = block[j];
+      aes_cword_t v = block[j];
       block[j] = aes_nohw_xor(block[j], aes_nohw_shift_left(v, 4));
       block[j] = aes_nohw_xor(block[j], aes_nohw_shift_left(v, 8));
       block[j] = aes_nohw_xor(block[j], aes_nohw_shift_left(v, 12));
@@ -762,7 +788,7 @@
   key->rounds = 14;
 
