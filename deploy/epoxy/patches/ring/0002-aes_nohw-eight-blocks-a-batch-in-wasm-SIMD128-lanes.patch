   OPENSSL_memcpy(key->rd_key + 4, block2, 16);
 
   for (size_t i = 2; i <= 14; i += 2) {
-    aes_word_t sub[AES_NOHW_BLOCK_WORDS];
+    aes_cword_t sub[AES_NOHW_BLOCK_WORDS];
     aes_nohw_sub_block(sub, block2);
