diff --git a/src/proto/h1/dispatch.rs b/src/proto/h1/dispatch.rs
--- a/src/proto/h1/dispatch.rs
+++ b/src/proto/h1/dispatch.rs
@@ -120,6 +120,17 @@
         })
     }
 
+    /// Says on a client's error whether nothing of the response had come:
+    /// a request the server never answered (it closed the connection as the
+    /// request arrived) can be sent again
+    fn unanswered(&self, e: crate::Error) -> crate::Error {
+        if self.conn.is_unanswered() {
+            e.into_empty_response()
+        } else {
+            e
+        }
+    }
+
     fn poll_catch(
         &mut self,
         cx: &mut Context<'_>,
@@ -134,6 +145,7 @@
             // We just try to give the error to the user,
             // and close the connection with an Ok. If we
             // cannot give it to the user, then return the Err.
+            let e = self.unanswered(e);
             self.dispatch.recv_msg(Err(e))?;
             Ok(Dispatched::Shutdown)
         }))
@@ -305,6 +317,7 @@
