 src/client/dispatch.rs   |   1 +
 src/proto/h1/conn.rs     |  10 ++++++++++
 src/proto/h1/dispatch.rs |  13 +++++++++++++
 src/proto/h1/io.rs       |   9 +++++++++
 src/proto/h2/client.rs   |   4 ++--
 6 files changed, 97 insertions(+), 3 deletions(-)

diff --git a/src/error.rs b/src/error.rs
--- a/src/error.rs
+++ b/src/error.rs
@@ -35,6 +35,8 @@
 struct ErrorImpl {
     kind: Kind,
     cause: Option<Cause>,
+    /// the request's connection ended before any byte of its response
+    empty_response: bool,
 }
 
 #[derive(Debug)]
@@ -223,6 +225,37 @@
         matches!(self.inner.kind, Kind::IncompleteMessage)
     }
 
+    /// Returns true if the request's connection ended before any byte of its
+    /// response arrived.
+    ///
+    /// HTTP/1: the connection closed, was reset, or failed to read or write
+    /// once the request was handed to it, and no byte of a response (an
+    /// informational one included) had come. HTTP/2: the server sent GOAWAY,
+    /// or the connection closed or failed, before the stream's response
+    /// head. The server may have read the request, but it answered nothing:
+    /// a client that sent it on a connection that had carried a request
+    /// before can send it again, as browsers do (a server closing an idle
+    /// connection as the request reaches it).
+    pub fn is_empty_response(&self) -> bool {
+        self.inner.empty_response
+    }
+
+    /// Returns true if the server reset the request's HTTP/2 stream with
+    /// `REFUSED_STREAM`: it did no processing of the request (RFC 9113,
+    /// section 8.7), which can be sent again.
+    pub fn is_refused_stream(&self) -> bool {
+        #[cfg(not(all(any(feature = "client", feature = "server"), feature = "http2")))]
+        return false;
+
+        #[cfg(all(any(feature = "client", feature = "server"), feature = "http2"))]
+        {
+            matches!(self.inner.kind, Kind::Http2)
+                && self.find_source::<h2::Error>().map_or(false, |e| {
+                    e.is_reset() && e.is_remote() && e.reason() == Some(h2::Reason::REFUSED_STREAM)
+                })
+        }
+    }
+
     /// Returns true if the body write was aborted.
     pub fn is_body_write_aborted(&self) -> bool {
         #[cfg(not(any(
@@ -249,7 +282,11 @@
 
     pub(super) fn new(kind: Kind) -> Error {
         Error {
-            inner: Box::new(ErrorImpl { kind, cause: None }),
+            inner: Box::new(ErrorImpl {
+                kind,
+                cause: None,
+                empty_response: false,
+            }),
         }
     }
 
@@ -258,6 +295,30 @@
         self
     }
 
+    /// the request's connection ended before any byte of its response
+    #[cfg(any(feature = "http1", all(feature = "client", feature = "http2")))]
+    pub(crate) fn into_empty_response(mut self) -> Error {
+        self.inner.empty_response = true;
+        self
+    }
+
+    /// An HTTP/2 request's stream failed before its response head: an empty
+    /// response when its connection went away (the server's GOAWAY, or the
+    /// connection closed or failed), not when the stream itself was reset
+    #[cfg(all(feature = "client", feature = "http2"))]
+    pub(crate) fn h2_unanswered(self) -> Error {
+        let lost = matches!(self.inner.kind, Kind::Io)
+            || (matches!(self.inner.kind, Kind::Http2)
+                && self
+                    .find_source::<h2::Error>()
+                    .map_or(false, |e| e.is_go_away() && e.is_remote()));
+        if lost {
+            self.into_empty_response()
+        } else {
+            self
+        }
+    }
+
     #[cfg(any(all(feature = "http1", feature = "server"), feature = "ffi"))]
     pub(super) fn kind(&self) -> &Kind {
         &self.inner.kind
