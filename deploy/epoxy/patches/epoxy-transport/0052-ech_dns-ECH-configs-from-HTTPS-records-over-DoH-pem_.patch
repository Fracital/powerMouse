@@ -93,6 +107,20 @@ export default class EpoxyTransport implements ProxyTransport {
 			let options = new EpoxyClientOptions();
 			options.user_agent = navigator.userAgent;
 			opts.forEach((x) => this.setopt(options, x));
+			if (this.opts.ech_dns) {
+				// the lookups go through this client: the resolver skips the
