From 4be2d2228926faf0a274dd1c9421e28ff3128702 Mon Sep 17 00:00:00 2001
From: David Reed <reedswork@proton.me>
Date: Thu, 19 Nov 2026 04:36:00 -0500
Subject: [PATCH] ech_dns: answers kept per network partition for their TTL,
 and in the host's ech_cache across a reload

Each partition's client asks the resolver for its own partition
(EpoxyClient.partition's resolver), and the answers are kept by partition
and name, as Chrome's host cache keeps them: a name is asked again for each
top-level site, and again for a frame cross-site to its top. An answer is
kept for its TTL and never longer: the smallest TTL of the records taken
(CNAMEs and the HTTPS record), capped at a day; a name with no HTTPS record
for its SOA's negative TTL (RFC 2308), and not at all when the answer has
no SOA. Before, every partition shared one cache, a TTL under 60 s was
kept for 60 s, and a name without a record for 5 minutes. A lookup that
got no answer (a fetch error, SERVFAIL) is not asked again for 30 s and is
never kept by the host.

`ech_cache` (an EchCache: `load()` and `put(entry)`) is where the host keeps
the answers across the realm's end: the resolver reads it once at init,
waits for it before its first lookup, uses an entry until the time it was
kept until, and puts each answer it keeps.
---
 src/ech.ts  | 170 +++++++++++++++++++++++++++++++++++++++++-----------
 src/main.ts |  47 +++++++++++----
 2 files changed, 171 insertions(+), 46 deletions(-)

diff --git a/src/ech.ts b/src/ech.ts
index 557df04..688b859 100644
--- a/src/ech.ts
+++ b/src/ech.ts
@@ -4,13 +4,23 @@
 // encrypts its ClientHello to it (RFC 9849); without one it sends a GREASE
 // ECH. The wisp server resolves addresses only, so the record is asked of a
 // DoH server through the client itself.
+//
+// Answers are kept as Chrome's host cache keeps them: by the network
+// partition that asked (Chrome 157 asks a name again for each top-level
+// site, and again for a frame cross-site to its top), for the answer's TTL
+// and never longer (the smallest TTL of the records it took; a name with no
+// record for its SOA's negative TTL, RFC 2308; nothing at all when the
+// answer gives no TTL to keep it by). A host may hand in an EchCache, which
+// keeps them across the realm's end (a reload): what it gives back is used
+// until the time it was kept until, and nothing past it.
 
+const TYPE_CNAME = 5;
+const TYPE_SOA = 6;
 const TYPE_HTTPS = 65;
 const KEY_ECH = 5;
-/** how long a name without a usable record is not asked again */
-const NEGATIVE_MS = 5 * 60 * 1000;
-/** a record's TTL is kept at least this long, at most a day */
-const MIN_TTL_MS = 60 * 1000;
+/** a lookup that failed (no answer, an error status) is not asked again for this long; it is never kept by the host */
+const FAILED_MS = 30 * 1000;
+/** an answer is kept a day at most, whatever its TTL (Chrome's cache caps it too) */
 const MAX_TTL_MS = 24 * 60 * 60 * 1000;
 /**
  * how long a connection waits for the answer: Chrome waits for the HTTPS
@@ -47,58 +57,143 @@ function skipName(view: DataView, offset: number): number {
 	}
 }
 
+/** what a DoH answer says of a name: its ECH config list (null: none), and for how many seconds (null: not to be kept) */
+export interface HttpsAnswer {
+	ech: Uint8Array | null;
+	ttl: number | null;
+}
+
 /**
  * The `ech` of the first ServiceMode HTTPS record in a DoH answer (a record
- * for the CNAME target the resolver followed counts as the name's), with
- * the answer's TTL; `null` when there is none.
+ * for the CNAME target the resolver followed counts as the name's), and the
+ * TTL to keep the answer by: the smallest of the records taken (the CNAMEs
+ * and the HTTPS record); for an answer with no HTTPS record (NODATA or
+ * NXDOMAIN), the negative TTL of its SOA, the smaller of the SOA's own TTL
+ * and its MINIMUM (RFC 2308 5), or null without one. A message that is no
+ * answer (too short, an error other than NXDOMAIN) throws.
  */
-export function parseEch(
-	message: ArrayBuffer
-): { ech: Uint8Array; ttl: number } | null {
+export function parseHttps(message: ArrayBuffer): HttpsAnswer {
 	const view = new DataView(message);
-	if (view.byteLength < 12 || (view.getUint8(3) & 0x0f) !== 0) return null;
+	if (view.byteLength < 12) throw new Error("short DNS message");
+	const rcode = view.getUint8(3) & 0x0f;
+	// NOERROR and NXDOMAIN are answers; SERVFAIL, REFUSED and the rest are not
+	if (rcode !== 0 && rcode !== 3) throw new Error(`DNS rcode ${rcode}`);
 	const questions = view.getUint16(4);
 	const answers = view.getUint16(6);
+	const authorities = view.getUint16(8);
 	let offset = 12;
 	for (let i = 0; i < questions; i++) offset = skipName(view, offset) + 4;
+	let ttl: number | null = null;
+	const least = (value: number) => (ttl = ttl === null ? value : Math.min(ttl, value));
+	let found: Uint8Array | null = null;
+	let record = false;
 	for (let i = 0; i < answers; i++) {
 		offset = skipName(view, offset);
 		const type = view.getUint16(offset);
-		const ttl = view.getUint32(offset + 4);
+		const rrTtl = view.getUint32(offset + 4);
 		const start = offset + 10;
 		const end = start + view.getUint16(offset + 8);
 		offset = end;
-		if (type !== TYPE_HTTPS || end > view.byteLength) continue;
+		if (end > view.byteLength) break;
+		if (type === TYPE_CNAME) {
+			least(rrTtl);
+			continue;
+		}
+		if (type !== TYPE_HTTPS || record) continue;
+		record = true;
+		least(rrTtl);
 		// AliasMode (priority 0) names no parameters
 		if (view.getUint16(start) === 0) continue;
 		// the target name is never compressed in RDATA (RFC 9460 2.2)
 		for (let at = skipName(view, start + 2); at + 4 <= end; ) {
 			const key = view.getUint16(at);
 			const len = view.getUint16(at + 2);
-			if (key === KEY_ECH && at + 4 + len <= end)
-				return { ech: new Uint8Array(message.slice(at + 4, at + 4 + len)), ttl };
+			if (key === KEY_ECH && at + 4 + len <= end) {
+				found = new Uint8Array(message.slice(at + 4, at + 4 + len));
+				break;
+			}
 			at += 4 + len;
 		}
-		return null;
 	}
-	return null;
+	if (record) return { ech: found, ttl };
+	// no record: the negative answer's TTL is the SOA's
+	for (let i = 0; i < authorities; i++) {
+		offset = skipName(view, offset);
+		if (offset + 10 > view.byteLength) break;
+		const type = view.getUint16(offset);
+		const rrTtl = view.getUint32(offset + 4);
+		const start = offset + 10;
+		const end = start + view.getUint16(offset + 8);
+		offset = end;
+		if (type !== TYPE_SOA || end > view.byteLength) continue;
+		const fixed = skipName(view, skipName(view, start));
+		if (fixed + 20 > end) continue;
+		const minimum = view.getUint32(fixed + 16);
+		return { ech: null, ttl: Math.min(rrTtl, minimum) };
+	}
+	return { ech: null, ttl: null };
+}
+
+/** one kept answer: a partition's name (`EchResolver.key`), its ECH config list or none, and when it is stale (ms since the epoch) */
+export interface EchCacheEntry {
+	key: string;
+	ech: Uint8Array | null;
+	until: number;
+}
+
+/**
+ * Where a host keeps answers across the realm's end (a reload, a new tab):
+ * `load` gives back what was kept (stale entries may come back; they are
+ * not used), `put` keeps one more, and replaces the one of its key.
+ */
+export interface EchCache {
+	load(): Promise<EchCacheEntry[]>;
+	put(entry: EchCacheEntry): void;
 }
 
 type Fetch = (url: string, accept: string) => Promise<ArrayBuffer>;
 
-/** ECH config lists by host name, from one DoH endpoint, with their TTLs */
+interface Kept {
+	until: number;
+	value: Promise<Uint8Array | null>;
+}
+
+/** ECH config lists by network partition and host name, from one DoH endpoint, with their TTLs */
 export class EchResolver {
 	#dns: URL;
 	#fetch: Fetch;
-	#cache = new Map<string, { until: number; value: Promise<Uint8Array | null> }>();
+	#store: EchCache | null;
+	#cache = new Map<string, Kept>();
+	/** settles once the host's kept answers are in */
+	#loading: Promise<void> | null = null;
 
-	constructor(dns: string, fetch: Fetch) {
+	constructor(dns: string, fetch: Fetch, store?: EchCache | null) {
 		this.#dns = new URL(dns);
 		this.#fetch = fetch;
+		this.#store = store ?? null;
+		if (this.#store)
+			this.#loading = this.#store
+				.load()
+				.then((entries) => {
+					const now = Date.now();
+					for (const { key, ech, until } of entries)
+						if (until > now && !this.#cache.has(key))
+							this.#cache.set(key, { until, value: Promise.resolve(ech) });
+				})
+				.catch(() => {})
+				.finally(() => (this.#loading = null));
+	}
+
+	/** the key of `name` in `partition` ("" for requests that name none) */
+	static key(partition: string, name: string): string {
+		return `${partition}\n${name}`;
 	}
 
-	/** what epoxy-tls's `ech_resolver` is given */
-	resolve = (host: string): Promise<Uint8Array | null> => {
+	/** what epoxy-tls's `ech_resolver` is given: the main client's lookups */
+	resolve = (host: string): Promise<Uint8Array | null> => this.resolveIn("", host);
+
+	/** a lookup of `host` for the network partition `partition` (EpoxyClient.partition's resolver) */
+	resolveIn(partition: string, host: string): Promise<Uint8Array | null> {
 		const name = host.toLowerCase().replace(/\.$/, "");
 		// the DoH server's own name is never asked (its lookup would wait on
 		// itself), and neither is an address or a name that is never public
@@ -109,29 +204,34 @@ export class EchResolver {
 			/(^|\.)(localhost|local|internal|test|invalid)$/.test(name)
 		)
 			return Promise.resolve(null);
-		const cached = this.#cache.get(name);
+		if (this.#loading) return this.#loading.then(() => this.resolveIn(partition, host));
+		const key = EchResolver.key(partition, name);
+		const cached = this.#cache.get(key);
 		if (cached && cached.until > Date.now()) return wait(cached.value);
-		const entry = { until: Date.now() + NEGATIVE_MS, value: this.#ask(name) };
-		this.#cache.set(name, entry);
+		// asked once at a time: the entry stands for the lookup in flight
+		const entry: Kept = { until: Infinity, value: null! };
+		entry.value = this.#ask(key, name, entry);
+		this.#cache.set(key, entry);
 		return wait(entry.value);
-	};
+	}
 
-	async #ask(name: string): Promise<Uint8Array | null> {
+	async #ask(key: string, name: string, entry: Kept): Promise<Uint8Array | null> {
 		const url = new URL(this.#dns);
 		url.searchParams.set("dns", base64url(httpsQuery(name)));
+		let answer: HttpsAnswer;
 		try {
-			const found = parseEch(
-				await this.#fetch(url.href, "application/dns-message")
-			);
-			if (!found) return null;
-			const entry = this.#cache.get(name);
-			if (entry)
-				entry.until =
-					Date.now() + Math.min(Math.max(found.ttl * 1000, MIN_TTL_MS), MAX_TTL_MS);
-			return found.ech;
+			answer = parseHttps(await this.#fetch(url.href, "application/dns-message"));
 		} catch {
+			// no answer: not kept, asked again after a while
+			entry.until = Date.now() + FAILED_MS;
 			return null;
 		}
+		const now = Date.now();
+		entry.until =
+			answer.ttl === null ? now : now + Math.min(answer.ttl * 1000, MAX_TTL_MS);
+		if (entry.until > now && this.#cache.get(key) === entry)
+			this.#store?.put({ key, ech: answer.ech, until: entry.until });
+		return answer.ech;
 	}
 }
 
diff --git a/src/main.ts b/src/main.ts
index d9817cb..57be833 100644
--- a/src/main.ts
+++ b/src/main.ts
@@ -9,7 +9,9 @@ import initEpoxy, {
 	EpoxyHandlers,
 	info as epoxyInfo,
 } from "@mercuryworkshop/epoxy-tls/epoxy";
-import { EchResolver } from "./ech";
+import { EchResolver, type EchCache } from "./ech";
+
+export type { EchCache, EchCacheEntry } from "./ech";
 
 export { epoxyInfo };
 
@@ -37,6 +39,13 @@ export type EpoxyOptions = {
 	 * Unset, every connection sends a GREASE ECH.
 	 */
 	ech_dns?: string;
+
+	/**
+	 * Where the `ech_dns` answers are kept across the realm's end (a
+	 * reload), each until its TTL runs out: the host's store, say IndexedDB.
+	 * Unset, they are kept in this transport only.
+	 */
+	ech_cache?: EchCache;
 };
 const opts = [
 	"wisp_v2",
@@ -105,6 +114,8 @@ export default class EpoxyTransport implements ProxyTransport {
 	};
 	/** by name, the one used longest ago first */
 	private partitions = new Map<string, Partition>();
+	/** the `ech_dns` lookups, per partition, when there is a DoH endpoint */
+	private ech: EchResolver | null = null;
 	private initializing: Promise<void> | null = null;
 
 	client_version: typeof epoxyInfo;
@@ -136,15 +147,20 @@ export default class EpoxyTransport implements ProxyTransport {
 			if (this.opts.ech_dns) {
 				// the lookups go through this client: the resolver skips the
 				// DoH server's own name, so its connection never waits on itself
-				const resolver = new EchResolver(this.opts.ech_dns, async (url, accept) => {
-					const res = await this.client.fetch(url, {
-						method: "GET",
-						headers: { accept },
-						redirect: "manual",
-					});
-					if (res.status !== 200) throw new Error(`DoH answered ${res.status}`);
-					return await res.arrayBuffer();
-				});
+				const resolver = new EchResolver(
+					this.opts.ech_dns,
+					async (url, accept) => {
+						const res = await this.client.fetch(url, {
+							method: "GET",
+							headers: { accept },
+							redirect: "manual",
+						});
+						if (res.status !== 200) throw new Error(`DoH answered ${res.status}`);
+						return await res.arrayBuffer();
+					},
+					this.opts.ech_cache
+				);
+				this.ech = resolver;
 				options.ech_resolver = resolver.resolve;
 			}
 			this.client = new EpoxyClient(this.wisp, options);
@@ -241,7 +257,16 @@ export default class EpoxyTransport implements ProxyTransport {
 			this.partitions.delete(other);
 			over--;
 		}
-		const partition = { client: this.client.partition(), inFlight: 0, used: now };
+		// its HTTPS records are its own, as Chrome keys its host cache by the
+		// partition
+		const ech = this.ech;
+		const partition = {
+			client: this.client.partition(
+				ech ? (host: string) => ech.resolveIn(name, host) : undefined
+			),
+			inFlight: 0,
+			used: now,
+		};
 		this.partitions.set(name, partition);
 		return partition;
 	}
