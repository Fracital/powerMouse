+    pub(crate) qpack_max_table_capacity: u64,
+    /// SETTINGS_QPACK_BLOCKED_STREAMS: how many streams may wait on the
+    /// dynamic table at once
+    pub(crate) qpack_max_blocked_streams: u64,
 }
 
 impl From<&frame::Settings> for Settings {
@@ -65,6 +71,12 @@ impl From<&frame::Settings> for Settings {
                 .get(frame::SettingId::ENABLE_CONNECT_PROTOCOL)
                 .map(|value| value != 0)
                 .unwrap_or(defaults.enable_extended_connect),
+            qpack_max_table_capacity: settings
+                .get(frame::SettingId::QPACK_MAX_TABLE_CAPACITY)
+                .unwrap_or(defaults.qpack_max_table_capacity),
+            qpack_max_blocked_streams: settings
+                .get(frame::SettingId::QPACK_MAX_BLOCKED_STREAMS)
+                .unwrap_or(defaults.qpack_max_blocked_streams),
         }
     }
 }
@@ -85,9 +97,46 @@ impl TryFrom<Config> for frame::Settings {
                     enable_extended_connect,
                     enable_datagram,
                     max_webtransport_sessions,
+                    qpack_max_table_capacity,
+                    qpack_max_blocked_streams,
                 },
         } = value;
 
+        // Chrome's SETTINGS, in its order: QPACK_MAX_TABLE_CAPACITY,
+        // MAX_FIELD_SECTION_SIZE, QPACK_BLOCKED_STREAMS, H3_DATAGRAM, then one
+        // GREASE setting; a setting left at its default is not sent
+        if qpack_max_table_capacity != 0 {
+            settings.insert(
+                frame::SettingId::QPACK_MAX_TABLE_CAPACITY,
+                qpack_max_table_capacity,
+            )?;
+        }
+        settings.insert(
+            frame::SettingId::MAX_HEADER_LIST_SIZE,
+            max_field_section_size,
+        )?;
+        if qpack_max_blocked_streams != 0 {
+            settings.insert(
+                frame::SettingId::QPACK_MAX_BLOCKED_STREAMS,
+                qpack_max_blocked_streams,
+            )?;
+        }
+        if enable_extended_connect {
+            settings.insert(frame::SettingId::ENABLE_CONNECT_PROTOCOL, 1)?;
+        }
+        if enable_webtransport {
+            settings.insert(frame::SettingId::ENABLE_WEBTRANSPORT, 1)?;
+        }
+        if enable_datagram {
+            settings.insert(frame::SettingId::H3_DATAGRAM, 1)?;
+        }
+        if enable_webtransport {
+            settings.insert(
+                frame::SettingId::WEBTRANSPORT_MAX_SESSIONS,
+                max_webtransport_sessions,
+            )?;
+        }
+
         if send_grease {
             //  Grease Settings (https://www.rfc-editor.org/rfc/rfc9114.html#name-defined-settings-parameters)
             //= https://www.rfc-editor.org/rfc/rfc9114#section-7.2.4.1
@@ -103,7 +152,9 @@ impl TryFrom<Config> for frame::Settings {
             //# (Section 11.2.2).  These reserved settings MUST NOT be sent, and
             //# their receipt MUST be treated as a connection error of type
             //# H3_SETTINGS_ERROR.
-            match settings.insert(frame::SettingId::grease(), 0) {
+            // Chrome's: 0x1f * N + 0x21 for a random 32-bit N, a random
+            // 32-bit value, last
+            match settings.insert(frame::SettingId::grease(), fastrand::u32(..) as u64) {
                 Ok(_) => (),
                 Err(_err) => {
                     #[cfg(feature = "tracing")]
@@ -112,24 +163,6 @@ impl TryFrom<Config> for frame::Settings {
             }
         }
 
-        settings.insert(
-            frame::SettingId::MAX_HEADER_LIST_SIZE,
-            max_field_section_size,
-        )?;
-        settings.insert(
-            frame::SettingId::ENABLE_CONNECT_PROTOCOL,
-            enable_extended_connect as u64,
-        )?;
-        settings.insert(
-            frame::SettingId::ENABLE_WEBTRANSPORT,
-            enable_webtransport as u64,
-        )?;
-        settings.insert(frame::SettingId::H3_DATAGRAM, enable_datagram as u64)?;
-        settings.insert(
-            frame::SettingId::WEBTRANSPORT_MAX_SESSIONS,
-            max_webtransport_sessions,
-        )?;
-
         Ok(settings)
     }
 }
@@ -142,6 +175,8 @@ impl Default for Settings {
             enable_extended_connect: false,
             enable_datagram: false,
             max_webtransport_sessions: 0,
+            qpack_max_table_capacity: 0,
+            qpack_max_blocked_streams: 0,
         }
     }
 }
