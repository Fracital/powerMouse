From 477c53e3bf9a55f77a3ba89453b6ba1e9625a986 Mon Sep 17 00:00:00 2001
From: David Reed <reedswork@proton.me>
Date: Tue, 10 Nov 2026 14:19:35 -0500
Subject: [PATCH 2/4] SETTINGS, GREASE setting and GREASE frame as Chrome sends
 them

Chrome 152's HTTP/3 SETTINGS are QPACK_MAX_TABLE_CAPACITY,
MAX_FIELD_SECTION_SIZE, QPACK_BLOCKED_STREAMS, H3_DATAGRAM and one GREASE
setting, in that order (measured against a local aioquic server). h3 sent
its GREASE setting first with the value 0, and ENABLE_CONNECT_PROTOCOL,
ENABLE_WEBTRANSPORT and WEBTRANSPORT_MAX_SESSIONS at 0 that Chrome leaves
out. Now: settings at their default are not sent, the QPACK ones can be set
from the client builder, and the GREASE setting comes last with a random
32-bit value.

GREASE ids are 0x1f * N + 0x21 for a random 32-bit N, as Chrome's (h3 drew N
from the whole varint range). Chrome follows SETTINGS with one GREASE frame
of zero to three random bytes on the control stream and sends neither a
GREASE stream nor GREASE frames on request streams; h3 sent a GREASE stream
and a 6-byte "grease" frame at the end of the first request.
---
 src/client/builder.rs | 16 +++++++++-
 src/config.rs         | 73 ++++++++++++++++++++++++++++++++-----------
 src/connection.rs     | 16 ++++++++--
 src/proto/frame.rs    | 14 ++++++---
 4 files changed, 92 insertions(+), 27 deletions(-)

diff --git a/src/client/builder.rs b/src/client/builder.rs
index 5ae628d..da0655e 100644
--- a/src/client/builder.rs
+++ b/src/client/builder.rs
@@ -88,6 +88,19 @@ impl Builder {
         self
     }
 
+    /// SETTINGS_QPACK_MAX_TABLE_CAPACITY (RFC 9204): how large a dynamic
+    /// table the server's encoder may use for the responses
+    pub fn qpack_max_table_capacity(&mut self, value: u64) -> &mut Self {
+        self.config.settings.qpack_max_table_capacity = value;
+        self
+    }
+
+    /// SETTINGS_QPACK_BLOCKED_STREAMS (RFC 9204)
+    pub fn qpack_max_blocked_streams(&mut self, value: u64) -> &mut Self {
+        self.config.settings.qpack_max_blocked_streams = value;
+        self
+    }
+
     /// Just like in HTTP/2, HTTP/3 also uses the concept of "grease"
     /// to prevent potential interoperability issues in the future.
     /// In HTTP/3, the concept of grease is used to ensure that the protocol can evolve
@@ -132,7 +145,8 @@ impl Builder {
             conn_state,
             max_field_section_size: self.config.settings.max_field_section_size,
             sender_count: Arc::new(AtomicUsize::new(1)),
-            send_grease_frame: self.config.send_grease,
+            // the GREASE frame goes on the control stream, as Chrome's
+            send_grease_frame: false,
             _buf: PhantomData,
         };
 
diff --git a/src/config.rs b/src/config.rs
index c2a6fe6..4a3c754 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -41,6 +41,12 @@ pub struct Settings {
