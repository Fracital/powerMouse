+    /// The driver's share of QPACK and the control stream: read the peer's
+    /// encoder stream into the shared decoder (which wakes blocked request
+    /// streams), write the decoder instructions and queued control frames
+    fn poll_qpack(&mut self, cx: &mut Context<'_>) -> Result<(), ConnectionError> {
+        enum Ended {
+            Closed,
+            Error(StreamErrorIncoming),
+        }
+        let mut ended = None;
+        if let Some(AcceptedRecvStream::Encoder(stream)) = &mut self.qpack_streams.encoder_recv {
+            loop {
+                match stream.poll_read(cx) {
+                    Poll::Ready(Ok(false)) => continue,
+                    Poll::Ready(Ok(true)) => {
+                        ended = Some(Ended::Closed);
+                        break;
+                    }
+                    Poll::Ready(Err(e)) => {
+                        ended = Some(Ended::Error(e));
+                        break;
+                    }
+                    Poll::Pending => break,
+                }
+            }
+            while let Some(chunk) = stream.take_chunk(usize::MAX) {
+                self.qpack_streams.encoder_in.extend_from_slice(&chunk);
+            }
+        }
+        if !self.qpack_streams.encoder_in.is_empty() {
+            if let Err(_e) = self
+                .shared
+                .on_qpack_encoder(&mut self.qpack_streams.encoder_in)
+            {
+                return Err(self.handle_connection_error(InternalConnectionError::new(
+                    Code::QPACK_ENCODER_STREAM_ERROR,
+                    format!("encoder stream: {}", _e),
+                )));
+            }
+        }
+        match ended {
+            None => (),
+            Some(Ended::Error(StreamErrorIncoming::ConnectionErrorIncoming { connection_error })) => {
+                return Err(self.handle_connection_error(connection_error));
+            }
+            //= https://www.rfc-editor.org/rfc/rfc9204#section-4.2
+            //# Closure of either unidirectional stream type MUST be treated as a
+            //# connection error of type H3_CLOSED_CRITICAL_STREAM.
+            Some(_) => {
+                return Err(self.handle_connection_error(InternalConnectionError::new(
+                    Code::H3_CLOSED_CRITICAL_STREAM,
+                    "the peer's QPACK encoder stream ended".to_string(),
+                )));
+            }
+        }
+
+        let out = self.shared.take_qpack_out();
+        let streams = &mut self.qpack_streams;
+        if !out.is_empty() && streams.decoder_send.is_some() {
+            if !streams.decoder_type_sent {
+                streams.decoder_type_sent = true;
+                let mut ty = BytesMut::new();
+                UniStreamHeader::Decoder.encode(&mut ty);
+                streams.decoder_out.extend_from_slice(&ty);
+            }
+            streams.decoder_out.extend_from_slice(&out);
+        }
+        let mut result = Ok(());
+        if let Some(stream) = &mut streams.decoder_send {
+            result = poll_write_raw(
+                stream,
+                &mut streams.decoder_writing,
+                &mut streams.decoder_out,
+                cx,
+            );
+        }
+        if result.is_ok() {
+            self.control_out
+                .extend_from_slice(&self.shared.take_control_out());
+            result = poll_write_raw(
+                &mut self.control_send,
+                &mut self.control_writing,
+                &mut self.control_out,
+                cx,
+            );
+        }
+        match result {
+            Ok(()) => Ok(()),
+            Err(StreamErrorIncoming::ConnectionErrorIncoming { connection_error }) => {
+                Err(self.handle_connection_error(connection_error))
+            }
+            Err(_) => Err(self.handle_connection_error(InternalConnectionError::new(
+                Code::H3_CLOSED_CRITICAL_STREAM,
+                "a critical stream could not be written".to_string(),
+            ))),
+        }
+    }
