+impl<B> WriteBuf<B>
+where
+    B: Buf,
+{
+    /// The most bytes one `raw` buffer holds
+    pub(crate) const RAW_MAX: usize = WRITE_BUF_ENCODE_SIZE;
+
+    /// Bytes written as they are (at most `RAW_MAX`)
+    pub(crate) fn raw(data: &[u8]) -> Self {
+        let mut me = Self {
+            buf: [0; WRITE_BUF_ENCODE_SIZE],
+            len: data.len(),
+            pos: 0,
+            frame: None,
+        };
+        me.buf[..data.len()].copy_from_slice(data);
+        me
+    }
+}
