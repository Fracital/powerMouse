+impl SharedState {
+    /// The dynamic table capacity we advertise (SETTINGS_QPACK_MAX_TABLE_CAPACITY)
+    pub(crate) fn set_qpack_max_capacity(&self, max_capacity: usize) {
+        self.qpack.lock().unwrap().decoder = qpack::Decoder::new(max_capacity);
+    }
+
+    /// Decode a field section received on `stream_id`. Pending while the
+    /// section references entries the encoder stream has not delivered yet
+    /// (a blocked stream, RFC 9204 section 2.1.2); a section that used the
+    /// dynamic table is acknowledged on the decoder stream.
+    pub(crate) fn poll_decode(
+        &self,
+        cx: &mut Context<'_>,
+        stream_id: u64,
+        block: &Bytes,
+        max_size: u64,
+    ) -> Poll<Result<Decoded, DecoderError>> {
+        let mut q = self.qpack.lock().unwrap();
+        let required = q.decoder.required_insert_count(block)?;
+        if required > q.decoder.total_inserted() {
+            q.blocked.push(cx.waker().clone());
+            return Poll::Pending;
+        }
+        let mut buf = block.clone();
+        let decoded = q.decoder.decode_header(&mut buf)?;
+        if decoded.dyn_ref {
+            //= https://www.rfc-editor.org/rfc/rfc9204#section-4.4.1
+            //# After processing an encoded field section whose declared Required
+            //# Insert Count is not zero, the decoder emits a Section
+            //# Acknowledgment instruction.
+            qpack::ack_header(stream_id, &mut q.out);
+            drop(q);
+            self.waker.wake();
+        }
+        if decoded.mem_size > max_size {
+            return Poll::Ready(Err(DecoderError::HeaderTooLong(decoded.mem_size)));
+        }
+        Poll::Ready(Ok(decoded))
+    }
+
+    /// Apply what arrived on the peer's encoder stream; complete
+    /// instructions are consumed from `data`, a partial one is left there
+    pub(crate) fn on_qpack_encoder(&self, data: &mut BytesMut) -> Result<(), DecoderError> {
+        let mut q = self.qpack.lock().unwrap();
+        let QpackDecoding {
+            decoder,
+            out,
+            blocked,
+        } = &mut *q;
+        let before = decoder.total_inserted();
+        decoder.on_encoder_recv(data, out)?;
+        if decoder.total_inserted() != before {
+            for waker in blocked.drain(..) {
+                waker.wake();
+            }
+        }
+        Ok(())
+    }
+
+    /// Decoder instructions to send
+    pub(crate) fn take_qpack_out(&self) -> Vec<u8> {
+        std::mem::take(&mut self.qpack.lock().unwrap().out)
+    }
+
+    /// Queue a frame for our control stream and wake the driver to send it
+    pub(crate) fn push_control(&self, frame: &[u8]) {
+        self.control_out.lock().unwrap().extend_from_slice(frame);
+        self.waker.wake();
+    }
+
+    /// Control stream frames to send
+    pub(crate) fn take_control_out(&self) -> Vec<u8> {
+        std::mem::take(&mut self.control_out.lock().unwrap())
+    }
+}
