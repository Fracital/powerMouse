+
+/// Write `queue` to `stream` without waiting: what is accepted now goes,
+/// the rest waits for the next poll
+fn poll_write_raw<S, B>(
+    stream: &mut S,
+    writing: &mut bool,
+    queue: &mut BytesMut,
+    cx: &mut Context<'_>,
+) -> Result<(), StreamErrorIncoming>
+where
+    S: SendStream<B>,
+    B: Buf,
+{
+    loop {
+        if *writing {
+            match stream.poll_ready(cx) {
+                Poll::Ready(Ok(())) => *writing = false,
+                Poll::Ready(Err(e)) => return Err(e),
+                Poll::Pending => return Ok(()),
+            }
+        }
+        if queue.is_empty() {
+            return Ok(());
+        }
+        let chunk = queue.split_to(queue.len().min(WriteBuf::<B>::RAW_MAX));
+        stream.send_data(WriteBuf::<B>::raw(&chunk))?;
+        *writing = true;
+    }
 }
 
