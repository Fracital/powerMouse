+/// The QPACK decoder of a connection that lets the peer use a dynamic table
+/// (RFC 9204): the driver feeds it the peer's encoder stream, request
+/// streams decode their field sections with it and wait while a section
+/// needs entries that have not arrived yet
+pub(crate) struct QpackDecoding {
+    decoder: qpack::Decoder,
+    /// decoder instructions (Section Acknowledgment, Insert Count
+    /// Increment) the driver has yet to write on our decoder stream
+    out: Vec<u8>,
+    /// streams blocked on entries not inserted yet
+    blocked: Vec<Waker>,
+}
+
+impl Default for QpackDecoding {
+    fn default() -> Self {
+        Self {
+            decoder: qpack::Decoder::new(0),
+            out: Vec::new(),
+            blocked: Vec::new(),
+        }
+    }
+}
+
+impl fmt::Debug for QpackDecoding {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("QpackDecoding")
+            .field("inserted", &self.decoder.total_inserted())
+            .field("out", &self.out.len())
+            .field("blocked", &self.blocked.len())
+            .finish()
+    }
+}
 
