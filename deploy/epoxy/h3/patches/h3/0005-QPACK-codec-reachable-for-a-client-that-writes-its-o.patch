--- /dev/null
+++ b/src/qpack_codec.rs
@@ -0,0 +1,89 @@
+//! QPACK (RFC 9204) for a client that writes and reads its own HTTP/3
+//! streams (stomp-h3's WebTransport session): the dynamic-table decoder the
+//! connection uses, the static table and Huffman coding, without the rest of
+//! h3's connection machinery.
+
+use bytes::{Buf, BytesMut};
+
+use crate::qpack::{self, HpackStringEncode, HeaderField, StaticTable};
+
+/// A field section decoder with the peer's dynamic table
+pub struct Decoder {
+    inner: qpack::Decoder,
+}
+
+impl Decoder {
+    /// A decoder for a connection that advertised `max_capacity` as its
+    /// SETTINGS_QPACK_MAX_TABLE_CAPACITY
+    pub fn new(max_capacity: usize) -> Self {
+        Self {
+            inner: qpack::Decoder::new(max_capacity),
+        }
+    }
+
+    /// Entries inserted so far
+    pub fn total_inserted(&self) -> usize {
+        self.inner.total_inserted()
+    }
+
+    /// Apply what arrived on the peer's encoder stream. Whole instructions
+    /// are consumed from `data` (a partial one stays there for the rest);
+    /// the decoder instructions to send (Insert Count Increment) are
+    /// appended to `out`.
+    pub fn on_encoder(&mut self, data: &mut BytesMut, out: &mut Vec<u8>) -> Result<(), String> {
+        self.inner
+            .on_encoder_recv(data, out)
+            .map(|_| ())
+            .map_err(|e| e.to_string())
+    }
+
+    /// The Required Insert Count of a field section
+    pub fn required_insert_count(&self, block: &[u8]) -> Result<usize, String> {
+        self.inner
+            .required_insert_count(block)
+            .map_err(|e| e.to_string())
+    }
+
+    /// Decode a field section whose entries have all arrived: its fields in
+    /// order, whether it referenced the dynamic table, and its size as RFC
+    /// 9114 section 4.2.2 counts it
+    pub fn decode(&self, block: &[u8]) -> Result<(Vec<(Vec<u8>, Vec<u8>)>, bool, u64), String> {
+        let mut buf = block;
+        let decoded = self
+            .inner
+            .decode_header(&mut buf)
+            .map_err(|e| e.to_string())?;
+        if buf.has_remaining() {
+            return Err("trailing bytes".to_string());
+        }
+        let fields = decoded
+            .fields
+            .into_iter()
+            .map(|f| {
+                let (name, value) = f.into_inner();
+                (name.into_owned(), value.into_owned())
+            })
+            .collect();
+        Ok((fields, decoded.dyn_ref, decoded.mem_size))
+    }
+}
+
+/// A Section Acknowledgment for `stream_id`, appended to `out`
+pub fn section_ack(stream_id: u64, out: &mut Vec<u8>) {
+    qpack::ack_header(stream_id, out);
+}
+
+/// The static table index of exactly `name: value`
+pub fn static_find(name: &[u8], value: &[u8]) -> Option<usize> {
+    StaticTable::find(&HeaderField::new(name, value))
+}
+
+/// The static table index of an entry named `name`
+pub fn static_find_name(name: &[u8]) -> Option<usize> {
+    StaticTable::find_name(name)
+}
+
+/// `value` Huffman coded (RFC 7541 appendix B)
+pub fn huffman_encode(value: &[u8]) -> Vec<u8> {
+    value.to_vec().hpack_encode().unwrap_or_default()
+}
