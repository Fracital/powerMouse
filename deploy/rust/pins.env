# Everything the toolchain image is made of, by digest or checksum. Bump,
# rebuild, rerun the suites, commit the new artifacts with the bump.

# rustlang/rust:nightly-bookworm as pulled 2026-11-10: rustc 1.102.0-nightly
# (ac8310ba6 2026-11-09). The digest pins the toolchain; RUST_NIGHTLY is what
# build.sh asserts the image's rustc reports, so a wrong image fails early.
RUST_IMAGE=rustlang/rust@sha256:dde6da7d1b5fa1ba0ebd311488ddc916f36311a2ce0038420ceba5ce76fdcc23
RUST_NIGHTLY=2026-11-09

# binaryen (wasm-opt), the GitHub release tarball
BINARYEN=version_124
BINARYEN_SHA256=0290c3779fedf592b8da0ded3032ff55c41a2b7bfa2d6bf7b7bac6f0e6e28963

# wasm-bindgen CLI, for a crate that uses it (the rewriter does not; see
# README.md). The same version deploy/epoxy installs, so a crate that moves
# between the two builds the same.
WASM_BINDGEN=0.2.100
WASM_BINDGEN_SHA256=63d6a38deb65bd7023c02bdf382ab66b0d2c0241c8582fd3413b5a808b8aeb5b
