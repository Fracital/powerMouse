{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": [
			"ESNext",
			"WebWorker",
			"Webworker.Iterable",
			"WebWorker.ImportScripts"
		],
		"types": [],
		"sourceMap": true,
		"strict": true,
		"stripInternal": true,
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true
	},
	"include": ["./*.d.ts", "../*.d.ts", "../../*.d.ts"]
}
