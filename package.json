{
	"name": "@sysce/stomp",
	"version": "4.2.0",
	"description": "A rewrite of the STomp proxy.",
	"keywords": [
		"proxy",
		"web-proxy",
		"service-worker",
		"wisp",
		"tomp"
	],
	"license": "GPL-3.0",
	"author": {
		"name": "David Reed",
		"url": "https://github.com/Fracital"
	},
	"homepage": "https://github.com/Fracital/powerMouse#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fracital/powerMouse.git"
	},
	"bugs": {
		"url": "https://github.com/Fracital/powerMouse/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/controller.mjs",
	"types": "./dist/types/controller/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/controller/index.d.ts",
			"default": "./dist/controller.mjs"
		},
		"./omnibox": {
			"types": "./dist/types/omnibox/index.d.ts",
			"default": "./dist/omnibox.mjs"
		},
		"./path": {
			"types": "./lib/index.d.cts",
			"default": "./lib/index.cjs"
		}
	},
	"files": [
		"dist",
		"!dist/vibeos",
		"lib"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "npm run check && node build.js && tsc -p tsconfig.types.json && node scripts/types-extensions.mjs && node scripts/build-offline.mjs",
		"build:demo-site": "node scripts/build-demo-site.mjs",
		"build:offline": "node scripts/build-offline.mjs",
		"dev": "node scripts/dev.mjs",
		"check": "tsc --noEmit",
		"check:types": "node scripts/check-types.mjs",
		"lint": "eslint src build.js demo/server.js demo/public/pm/dev.js demo/offline scripts test bench .github/scripts",
		"format": "prettier --write .",
		"check:prose": "node scripts/check-prose.mjs && node scripts/changelog.mjs check",
		"changelog": "node scripts/changelog.mjs fold",
		"demo": "node demo/server.js",
		"test": "node test/run.mjs",
		"test:firefox": "node test/firefox/smoke.mjs",
		"test262": "node test/test262/run.mjs",
		"test262:report": "node test/test262/report.mjs --known test/test262/known.txt",
		"bench": "python3 -I bench/run.py",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@mercuryworkshop/proxy-transports": "^1.0.2",
		"crypto-js": "^4.2.0",
		"entities": "^9.0.0",
		"idb": "^8.0.3",
		"tldts": "^7.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@fontsource/montserrat": "^5.3.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.4.0",
		"@mercuryworkshop/epoxy-transport": "github:Fracital/EpoxyTransport#75741326b5a4c78bc4495c214073a4023256a150",
		"@mercuryworkshop/libcurl-transport": "^2.0.6",
		"@simplewebauthn/server": "14.1.0",
		"@sysce/estrogen": "0.5.6",
		"@types/crypto-js": "^4.2.2",
		"@types/serviceworker": "^0.0.210",
		"epoxy-transport-e2a70d6": "git+https://github.com/Fracital/EpoxyTransport.git#e2a70d6a2f0fe0f067da226433e9ff9f95544784",
		"esbuild": "^0.28.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.0",
		"express": "^5.1.0",
		"globals": "^17.14.0",
		"holywisp": "0.5.3",
		"playwright-core": "1.65.1",
		"prettier": "^3.10.1",
		"rimraf": "^6.0.1",
		"tor-js": "github:Fracital/tor-js#789147dba8ff95d6fc4f0f3d2af068a2607603a4",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.73.0",
		"werift": "^0.27.0",
		"ws": "^8.23.0"
	}
}
