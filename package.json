{
	"name": "stomp-rewrite",
	"version": "4.2.0",
	"description": "A rewrite of the Stomp proxy.",
	"license": "GPL-3.0",
	"type": "module",
	"main": "./dist/controller.mjs",
	"types": "./dist/types/controller/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/controller/index.d.ts",
			"default": "./dist/controller.mjs"
		},
		"./path": {
			"types": "./lib/index.d.cts",
			"default": "./lib/index.cjs"
		}
	},
	"files": [
		"dist",
		"lib"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "npm run check && node build.js && tsc -p tsconfig.types.json",
		"dev": "node scripts/dev.mjs",
		"check": "tsc --noEmit",
		"lint": "eslint src build.js demo/server.js demo/public/pm/dev.js scripts test",
		"format": "prettier --write .",
		"check:prose": "node scripts/check-prose.mjs",
		"demo": "node demo/server.js",
		"test": "node test/run.mjs",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@javascript-obfuscator/escodegen": "^2.4.2",
		"@mercuryworkshop/proxy-transports": "^1.0.2",
		"ast-types": "^0.16.1",
		"crypto-js": "^4.2.0",
		"css-tree": "^3.1.0",
		"entities": "^9.0.0",
		"idb": "^8.0.3",
		"meriyah": "^7.0.0",
		"parse5": "^8.0.0",
		"set-cookie-parser": "^3.0.0",
		"srcset": "^5.0.1",
		"tldts": "^7.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@fontsource/montserrat": "^5.3.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.4.0",
		"@mercuryworkshop/epoxy-transport": "git+https://github.com/Fracital/EpoxyTransport.git#9f5b8872df45ed76ea0426b7bfdab50d722c1e41",
		"@mercuryworkshop/libcurl-transport": "^2.0.6",
		"@mercuryworkshop/wisp-js": "^0.5.2",
		"@types/crypto-js": "^4.2.2",
		"@types/css-tree": "^3.2.0",
		"@types/serviceworker": "^0.0.204",
		"esbuild": "^0.28.0",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.0",
		"express": "^5.1.0",
		"globals": "^16.0.0",
		"playwright-core": "1.65.0",
		"prettier": "^3.6.0",
		"rimraf": "^6.0.1",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.72.0",
		"ws": "^8.22.1"
	}
}
