+//! When the agent checks which pair: Chrome's way (STomp).
+//!
+//! libwebrtc's P2PTransportChannel, BasicIceController and Connection as
+//! Chrome 157 runs them, measured with a relay between Chrome and a peer
+//! (and remotes nothing answers at). A loop turns every 265.625 ms, or
+//! every 62.5 ms while the pair it sends on is weak (or there is none) or
+//! a pair has had fewer than 3 checks: its delays of 250 and 48 ms, on the
+//! 64 Hz metronome Chrome's WebRTC tasks wake on (so a turn a few ms late
+//! does not put the next one later). A turn checks one pair at
+//! most, and none when the last check of any went out less than 48 ms (480
+//! ms while not weak) before: the pair sent on when its interval passed,
+//! then one answered on its own checks whose interval passed while the
+//! pair sent on is weak, then one the peer checked and that has not been
+//! answered yet, then any other in the order of their last check (never
+//! checked first). A pair's interval is 48 ms for its first 3 checks, 900
+//! ms until it has 5 round trip times or while an answer is missing, and
+//! 2.5 s after that. So a connected pair is checked twice 1.06 s apart and
+//! then every 2.656 s, and a remote that never answers every 531 ms beside
+//! it (62.5 ms on a connection with no other pair). A pair is weak once
+//! nothing came from its remote for 2.5 s (unless its last check was
+//! answered) or once 5 checks went unanswered over 5 s. 15 s after the
+//! first check that went unanswered a pair is given up (the pair sent on is
+//! checked once more then, and leaves getStats at the next turn); the
+//! pair sent on stays, unchecked, until the peer checks it again. What the connection reads (disconnected at 5 s,
+//! failed at 15 s) is the host's.
+
+use std::time::{Duration, Instant};
+
+pub(crate) const TURN_DELAY: Duration = Duration::from_millis(250);
+pub(crate) const WEAK_TURN_DELAY: Duration = Duration::from_millis(48);
+const METRONOME_TICK: Duration = Duration::from_micros(15_625);
+pub(crate) const WEAK_INTERVAL: Duration = Duration::from_millis(48);
+pub(crate) const STRONG_INTERVAL: Duration = Duration::from_millis(480);
+const STABILIZING_INTERVAL: Duration = Duration::from_millis(900);
+const STABLE_INTERVAL: Duration = Duration::from_millis(2500);
+const RECEIVING_TIMEOUT: Duration = Duration::from_millis(2500);
+const UNWRITABLE_TIMEOUT: Duration = Duration::from_millis(5000);
+const UNWRITABLE_CHECKS: usize = 5;
+const INACTIVE_TIMEOUT: Duration = Duration::from_millis(15000);
+pub(crate) const PINGS_AT_WEAK_INTERVAL: usize = 3;
+/// round trip times before Chrome calls them converged (RTT_RATIO + 2)
+const CONVERGED_SAMPLES: u64 = 5;
+/// what Chrome takes a pair's round trip time to be before it has one
+const DEFAULT_RTT: Duration = Duration::from_millis(3000);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub(crate) enum Write {
+    /// never answered
+    #[default]
+    Init,
+    Writable,
+    /// checks unanswered for 5 s
+    Unreliable,
+    /// given up
+    Timeout,
+}
+
+/// The first tick of the metronome started at `start` after `at`: when a
+/// task Chrome posts for `at` runs. Its tasks run just after a tick, so a
+/// delay of 250 ms from one (16 ticks) runs at the 17th, 265.625 ms on.
+pub(crate) fn on_metronome(start: Instant, at: Instant) -> Instant {
+    let tick = METRONOME_TICK.as_nanos();
+    let ticks = at.saturating_duration_since(start).as_nanos() / tick + 1;
+    start + Duration::from_nanos((ticks * tick) as u64)
+}
+
+/// What Chrome keeps of a pair to pace its checks.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct Pace {
+    pings: usize,
+    last_ping: Option<Instant>,
+    last_answer: Option<Instant>,
+    last_received: Option<Instant>,
+    last_check_received: Option<Instant>,
+    samples: u64,
+    rtt: Option<Duration>,
+    /// when the checks since the last answer went
+    unanswered: Vec<Instant>,
+    write: Write,
+    /// the pair sent on was given up at this turn: it is checked once more
+    last_call: bool,
+    /// given up at an earlier turn: Chrome destroyed its connection, and
+    /// getStats no longer lists it
+    dead: bool,
+}
+
+impl Pace {
+    pub(crate) fn pings(&self) -> usize {
+        self.pings
+    }
+
+    pub(crate) fn last_ping(&self) -> Option<Instant> {
+        self.last_ping
+    }
+
+    pub(crate) fn writable(&self) -> bool {
+        self.write == Write::Writable
+    }
+
+    pub(crate) fn active(&self) -> bool {
+        self.write != Write::Timeout
+    }
+
+    /// getStats lists it: until the turn after it was given up (the turn
+    /// that gives up any other also prunes it)
+    pub(crate) fn listed(&self) -> bool {
+        !self.dead
+    }
+
+    pub(crate) fn pinged(&mut self, now: Instant) {
+        self.pings += 1;
+        self.last_ping = Some(now);
+        self.last_call = false;
+        self.unanswered.push(now);
+    }
+
+    pub(crate) fn answered(&mut self, now: Instant, rtt: Duration) {
+        self.samples += 1;
+        let before = self.rtt.unwrap_or(DEFAULT_RTT);
+        self.rtt = Some((before * 3 + rtt) / 4);
+        self.last_answer = Some(now);
+        self.last_received = Some(now);
+        self.unanswered.clear();
+        self.write = Write::Writable;
+    }
+
+    /// Something came from the pair's remote, a check of the peer's when
+    /// `check`: a pair that was given up is checked again.
+    pub(crate) fn received(&mut self, now: Instant, check: bool) {
+        self.last_received = Some(now);
+        if check {
+            self.last_check_received = Some(now);
+            if self.write == Write::Timeout {
+                self.write = Write::Init;
+                self.unanswered.clear();
+                self.dead = false;
+            }
+        }
+    }
+
+    fn rtt(&self) -> Duration {
+        self.rtt.unwrap_or(DEFAULT_RTT)
+    }
+
+    /// The pair's state at a turn: `sent_on` for the pair the agent sends on.
+    pub(crate) fn update(&mut self, now: Instant, sent_on: bool) {
+        self.dead = self.write == Write::Timeout;
+        let first = self.unanswered.first().copied();
+        let estimate = (self.rtt() * 2).clamp(Duration::from_millis(100), Duration::from_secs(60));
+        let failures = self
+            .unanswered
+            .get(UNWRITABLE_CHECKS - 1)
+            .is_some_and(|at| *at + estimate < now);
+        let waited = |limit: Duration| first.is_some_and(|at| now > at + limit);
+        if self.write == Write::Writable && failures && waited(UNWRITABLE_TIMEOUT) {
+            self.write = Write::Unreliable;
+        }
+        if matches!(self.write, Write::Init | Write::Unreliable) && waited(INACTIVE_TIMEOUT) {
+            self.write = Write::Timeout;
+            self.last_call = sent_on;
+        }
+    }
+
+    fn receiving(&self, now: Instant) -> bool {
+        match (self.last_ping, self.last_answer) {
+            (Some(ping), Some(answer)) if ping < answer => true,
+            _ => self
+                .last_received
+                .is_some_and(|at| now <= at + RECEIVING_TIMEOUT),
+        }
+    }
+
+    pub(crate) fn weak(&self, now: Instant) -> bool {
+        !(self.writable() && self.receiving(now))
+    }
+
+    /// The pair's own interval has passed since its last check.
+    pub(crate) fn due(&self, now: Instant) -> bool {
+        let missing = self
+            .unanswered
+            .first()
+            .is_some_and(|at| now.saturating_duration_since(*at) > self.rtt() * 2);
+        let interval = if self.pings < PINGS_AT_WEAK_INTERVAL {
+            WEAK_INTERVAL
+        } else if self.samples >= CONVERGED_SAMPLES && !missing {
+            STABLE_INTERVAL
+        } else {
+            STABILIZING_INTERVAL
+        };
+        self.last_ping.is_none_or(|at| at + interval <= now)
+    }
+
+    /// The pair may be checked at this turn, the pair sent on being `weak`.
+    pub(crate) fn pingable(&self, now: Instant, weak: bool) -> bool {
+        if self.last_call {
+            return true;
+        }
+        if !self.active() {
+            return false;
+        }
+        if weak || !self.writable() {
+            return true;
+        }
+        self.due(now)
+    }
+
+    /// The peer checked it since this side last did, and it is not answered yet.
+    pub(crate) fn needs_triggered_check(&self) -> bool {
+        !self.writable()
+            && self
+                .last_check_received
+                .is_some_and(|at| self.last_ping.is_none_or(|ping| at > ping))
+    }
+
+    pub(crate) fn last_check_received(&self) -> Option<Instant> {
+        self.last_check_received
+    }
+}
