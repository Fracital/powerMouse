+/// The first error cause of the ABORT chunk in an SCTP packet, if it has such a chunk.
+fn abort_cause(packet: &[u8]) -> Option<(u16, Vec<u8>)> {
+    const CT_ABORT: u8 = 6;
+    // The common header, then chunks of type, flags, length and a padded value.
+    let mut at = 12;
+    while at + 4 <= packet.len() {
+        let length = u16::from_be_bytes([packet[at + 2], packet[at + 3]]) as usize;
+        if length < 4 || at + length > packet.len() {
+            return None;
+        }
+        if packet[at] == CT_ABORT {
+            let causes = &packet[at + 4..at + length];
+            if causes.len() < 4 {
+                return Some((0, Vec::new()));
+            }
+            let code = u16::from_be_bytes([causes[0], causes[1]]);
+            let end = (u16::from_be_bytes([causes[2], causes[3]]) as usize).clamp(4, causes.len());
+            return Some((code, causes[4..end].to_vec()));
+        }
+        at += (length + 3) & !3;
+    }
+    None
+}
