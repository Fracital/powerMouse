{
	"id": "/",
	"name": "powerMouse",
	"short_name": "powerMouse",
	"description": "A browser in a page, on the STomp web proxy",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone"],
	"background_color": "#000000",
	"theme_color": "#000000",
	"icons": [
		{
			"src": "/pm/icons/app-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/pm/icons/app-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/pm/icons/app-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "New tab",
			"url": "/?launch=new-tab"
		},
		{
			"name": "Extensions",
			"url": "/?launch=extensions"
		},
		{
			"name": "Settings",
			"url": "/?launch=settings"
		}
	],
	"launch_handler": { "client_mode": "focus-existing" },
	"protocol_handlers": [{ "protocol": "web+stomp", "url": "/?launch=%s" }],
	"share_target": {
		"action": "/",
		"method": "GET",
		"enctype": "application/x-www-form-urlencoded",
		"params": { "title": "title", "text": "text", "url": "url" }
	}
}
