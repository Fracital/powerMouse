<!doctype html>
<meta charset="EUC-KR">
<title>document encoding</title>
<link rel="stylesheet" href="/pages/document-encoding-euc-kr-style.bin">
<link rel="stylesheet" href="/pages/document-encoding-euc-kr-rule.bin">
<script src="/pages/document-encoding-euc-kr-script.bin"></script>
<!-- document-encoding suite: a page in EUC-KR, its text in its own bytes -->
<a id="link" href="/pages/document-encoding-landing.html?q=한글&amp;r=%41+b">한글</a>
<form id="form" action="/pages/document-encoding-landing.html" accept-charset="EUC-KR">
<input name="q" value="한글 &amp;+%">
<input name="r" value="&#x20AC;&#x2603;">
</form>
<form id="utf8" action="/pages/document-encoding-landing.html" accept-charset="utf-8">
<input name="q" value="한글">
</form>
<div id="encoding-style"></div>
<div id="encoding-rule"></div>
<img id="img" alt="" src="/pages/document-encoding-landing.html?img=한글">
<script>
	const out = {};
	const read = (name, f) => {
		try {
			out[name] = f();
		} catch (error) {
			out[name] = 'threw ' + error.name;
		}
	};
	read('characterSet', () => document.characterSet);
	read('charset', () => document.charset);
	read('inputEncoding', () => document.inputEncoding);
	read('text', () => document.getElementById('link').textContent);
	read('linkSearch', () => document.getElementById('link').search);
	read('imgSrc', () => new URL(document.getElementById('img').src).search);
	read('madeLink', () => {
		const a = document.createElement('a');
		a.href = '/x?\ud55c\uae00\u00df\u2603#\ud55c\uae00';
		return a.search + a.hash;
	});
	read('formAction', () => {
		const form = document.createElement('form');
		form.action = '/x?\ud55c\uae00';
		return new URL(form.action).search;
	});
	read('newURL', () => new URL('/x?\ud55c\uae00', location.href).search);
	read('inert', () => {
		const doc = new DOMParser().parseFromString('<a href="http://h/?\ud55c\uae00">', 'text/html');
		return doc.querySelector('a').search;
	});
	read('xhr', () => {
		const xhr = new XMLHttpRequest();
		xhr.open('GET', '/pages/document-encoding-landing.html?xhr=\ud55c\uae00', false);
		xhr.send();
		return new URL(xhr.responseURL).search;
	});
	const worker = new Worker('/pages/document-encoding-worker.js?w=\ud55c\uae00');
	worker.onmessage = (event) => {
		out.worker = event.data;
		read('script', () => window.__scriptText);
		for (const sheet of ['style', 'rule'])
			read(
				sheet,
				() =>
					getComputedStyle(
						document.getElementById('encoding-' + sheet),
						'::after',
					).content,
			);
		out.done = true;
	};
	worker.onerror = () => {
		out.worker = 'error';
		out.done = true;
	};
	window.__encodingOut = out;
	// how the suite navigates the page: the page's own code, which the proxy
	// rewrites (a script the test evaluates is not)
	window.__navigate = {
		link: () => document.getElementById('link').click(),
		form: () => document.getElementById('form').submit(),
		utf8Form: () => document.getElementById('utf8').submit(),
		assign: () =>
			location.assign(
				'/pages/document-encoding-landing.html?a=' +
					document.getElementById('link').textContent,
			),
	};
</script>
